<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- =========================================================
         SMARTCLINIC / DORINGKLOOF MEDICAL CENTRE
         Shared mobile design system
         ========================================================= -->


    <!-- =========================
         BASE CONTROLS
         ========================= -->

    <Style TargetType="Page"
           ApplyToDerivedTypes="True">
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="BackgroundColor"
                Value="{StaticResource PageBackground}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />
        <Setter Property="BackgroundColor"
                Value="Transparent" />
        <Setter Property="FontFamily"
                Value="OpenSansRegular" />
        <Setter Property="FontSize"
                Value="14" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color"
                Value="{StaticResource Primary}" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor"
                Value="{StaticResource Primary}" />
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor"
                Value="{StaticResource Primary}" />
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="BackgroundColor"
                Value="{StaticResource Border}" />
    </Style>


    <!-- =========================
         TYPOGRAPHY
         ========================= -->

    <Style x:Key="PageTitleStyle"
           TargetType="Label">
        <Setter Property="FontFamily"
                Value="OpenSansSemibold" />
        <Setter Property="FontSize"
                Value="28" />
        <Setter Property="TextColor"
                Value="{StaticResource PrimaryDark}" />
        <Setter Property="LineBreakMode"
                Value="WordWrap" />
    </Style>

    <Style x:Key="PageSubtitleStyle"
           TargetType="Label">
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="TextColor"
                Value="{StaticResource TextSecondary}" />
        <Setter Property="LineBreakMode"
                Value="WordWrap" />
    </Style>

    <Style x:Key="SectionTitleStyle"
           TargetType="Label">
        <Setter Property="FontFamily"
                Value="OpenSansSemibold" />
        <Setter Property="FontSize"
                Value="18" />
        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />
    </Style>

    <Style x:Key="CardTitleStyle"
           TargetType="Label">
        <Setter Property="FontFamily"
                Value="OpenSansSemibold" />
        <Setter Property="FontSize"
                Value="16" />
        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />
    </Style>

    <Style x:Key="BodyTextStyle"
           TargetType="Label">
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />
        <Setter Property="LineBreakMode"
                Value="WordWrap" />
    </Style>

    <Style x:Key="MutedTextStyle"
           TargetType="Label">
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="TextColor"
                Value="{StaticResource TextSecondary}" />
        <Setter Property="LineBreakMode"
                Value="WordWrap" />
    </Style>

    <Style x:Key="FieldLabelStyle"
           TargetType="Label">
        <Setter Property="FontFamily"
                Value="OpenSansSemibold" />
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />
    </Style>

    <!-- Compatibility with the original MAUI template. -->
    <Style x:Key="Headline"
           TargetType="Label"
           BasedOn="{StaticResource PageTitleStyle}">
        <Setter Property="HorizontalOptions"
                Value="Center" />
        <Setter Property="HorizontalTextAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="SubHeadline"
           TargetType="Label"
           BasedOn="{StaticResource SectionTitleStyle}">
        <Setter Property="HorizontalOptions"
                Value="Center" />
        <Setter Property="HorizontalTextAlignment"
                Value="Center" />
    </Style>


    <!-- =========================
         BUTTONS
         ========================= -->

    <Style TargetType="Button">
        <Setter Property="TextColor"
                Value="{StaticResource White}" />
        <Setter Property="BackgroundColor"
                Value="{StaticResource Primary}" />
        <Setter Property="FontFamily"
                Value="OpenSansSemibold" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="BorderWidth"
                Value="0" />
        <Setter Property="CornerRadius"
                Value="10" />
        <Setter Property="Padding"
                Value="18,12" />
        <Setter Property="MinimumHeightRequest"
                Value="48" />
        <Setter Property="MinimumWidthRequest"
                Value="44" />

        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">

                    <VisualState x:Name="Normal" />

                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor"
                                    Value="{StaticResource Gray200}" />
                            <Setter Property="TextColor"
                                    Value="{StaticResource Gray500}" />
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="PointerOver" />

                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle"
           TargetType="Button">
        <Setter Property="BackgroundColor"
                Value="{StaticResource Primary}" />
        <Setter Property="TextColor"
                Value="{StaticResource White}" />
    </Style>

    <Style x:Key="SecondaryButtonStyle"
           TargetType="Button">
        <Setter Property="BackgroundColor"
                Value="{StaticResource White}" />
        <Setter Property="TextColor"
                Value="{StaticResource Primary}" />
        <Setter Property="BorderColor"
                Value="{StaticResource Primary}" />
        <Setter Property="BorderWidth"
                Value="1" />
    </Style>

    <Style x:Key="DangerButtonStyle"
           TargetType="Button">
        <Setter Property="BackgroundColor"
                Value="{StaticResource Secondary}" />
        <Setter Property="TextColor"
                Value="{StaticResource White}" />
    </Style>

    <Style x:Key="TextButtonStyle"
           TargetType="Button">
        <Setter Property="BackgroundColor"
                Value="Transparent" />
        <Setter Property="TextColor"
                Value="{StaticResource Primary}" />
        <Setter Property="Padding"
                Value="8" />
    </Style>


    <!-- =========================
         INPUT CONTROLS
         ========================= -->

    <Style TargetType="Entry">
        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />
        <Setter Property="PlaceholderColor"
                Value="{StaticResource TextSecondary}" />
        <Setter Property="BackgroundColor"
                Value="Transparent" />
        <Setter Property="FontFamily"
                Value="OpenSansRegular" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="MinimumHeightRequest"
                Value="48" />
        <Setter Property="MinimumWidthRequest"
                Value="44" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />
        <Setter Property="PlaceholderColor"
                Value="{StaticResource TextSecondary}" />
        <Setter Property="BackgroundColor"
                Value="Transparent" />
        <Setter Property="FontFamily"
                Value="OpenSansRegular" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="MinimumHeightRequest"
                Value="96" />
        <Setter Property="MinimumWidthRequest"
                Value="44" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />
        <Setter Property="TitleColor"
                Value="{StaticResource TextSecondary}" />
        <Setter Property="BackgroundColor"
                Value="Transparent" />
        <Setter Property="FontFamily"
                Value="OpenSansRegular" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="MinimumHeightRequest"
                Value="48" />
        <Setter Property="MinimumWidthRequest"
                Value="44" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />
        <Setter Property="BackgroundColor"
                Value="Transparent" />
        <Setter Property="FontFamily"
                Value="OpenSansRegular" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="MinimumHeightRequest"
                Value="48" />
        <Setter Property="MinimumWidthRequest"
                Value="44" />
    </Style>

    <Style TargetType="TimePicker">
        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />
        <Setter Property="BackgroundColor"
                Value="Transparent" />
        <Setter Property="FontFamily"
                Value="OpenSansRegular" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="MinimumHeightRequest"
                Value="48" />
        <Setter Property="MinimumWidthRequest"
                Value="44" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />
        <Setter Property="PlaceholderColor"
                Value="{StaticResource TextSecondary}" />
        <Setter Property="CancelButtonColor"
                Value="{StaticResource Primary}" />
        <Setter Property="BackgroundColor"
                Value="{StaticResource White}" />
        <Setter Property="FontFamily"
                Value="OpenSansRegular" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="MinimumHeightRequest"
                Value="48" />
    </Style>

    <Style TargetType="SearchHandler">
        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />
        <Setter Property="PlaceholderColor"
                Value="{StaticResource TextSecondary}" />
        <Setter Property="BackgroundColor"
                Value="{StaticResource White}" />
        <Setter Property="FontFamily"
                Value="OpenSansRegular" />
        <Setter Property="FontSize"
                Value="14" />
    </Style>


    <!-- =========================
         CARDS AND CONTAINERS
         ========================= -->

    <Style TargetType="Border">
        <Setter Property="Stroke"
                Value="{StaticResource Border}" />
        <Setter Property="StrokeThickness"
                Value="1" />
        <Setter Property="StrokeShape"
                Value="RoundRectangle 12" />
    </Style>

    <Style x:Key="CardStyle"
           TargetType="Border">
        <Setter Property="BackgroundColor"
                Value="{StaticResource Surface}" />
        <Setter Property="Stroke"
                Value="{StaticResource Border}" />
        <Setter Property="StrokeThickness"
                Value="1" />
        <Setter Property="StrokeShape"
                Value="RoundRectangle 14" />
        <Setter Property="Padding"
                Value="16" />
    </Style>

    <Style x:Key="InputBorderStyle"
           TargetType="Border">
        <Setter Property="BackgroundColor"
                Value="{StaticResource White}" />
        <Setter Property="Stroke"
                Value="{StaticResource Border}" />
        <Setter Property="StrokeThickness"
                Value="1" />
        <Setter Property="StrokeShape"
                Value="RoundRectangle 10" />
        <Setter Property="Padding"
                Value="12,2" />
    </Style>


    <!-- =========================
         FEEDBACK STATES
         ========================= -->

    <Style x:Key="SuccessBannerStyle"
           TargetType="Border">
        <Setter Property="BackgroundColor"
                Value="{StaticResource SuccessLight}" />
        <Setter Property="Stroke"
                Value="{StaticResource Success}" />
        <Setter Property="StrokeThickness"
                Value="1" />
        <Setter Property="StrokeShape"
                Value="RoundRectangle 10" />
        <Setter Property="Padding"
                Value="12" />
    </Style>

    <Style x:Key="ErrorBannerStyle"
           TargetType="Border">
        <Setter Property="BackgroundColor"
                Value="{StaticResource ErrorLight}" />
        <Setter Property="Stroke"
                Value="{StaticResource Error}" />
        <Setter Property="StrokeThickness"
                Value="1" />
        <Setter Property="StrokeShape"
                Value="RoundRectangle 10" />
        <Setter Property="Padding"
                Value="12" />
    </Style>

    <Style x:Key="WarningBannerStyle"
           TargetType="Border">
        <Setter Property="BackgroundColor"
                Value="{StaticResource WarningLight}" />
        <Setter Property="Stroke"
                Value="{StaticResource Warning}" />
        <Setter Property="StrokeThickness"
                Value="1" />
        <Setter Property="StrokeShape"
                Value="RoundRectangle 10" />
        <Setter Property="Padding"
                Value="12" />
    </Style>

    <Style x:Key="InfoBannerStyle"
           TargetType="Border">
        <Setter Property="BackgroundColor"
                Value="{StaticResource InfoLight}" />
        <Setter Property="Stroke"
                Value="{StaticResource Info}" />
        <Setter Property="StrokeThickness"
                Value="1" />
        <Setter Property="StrokeShape"
                Value="RoundRectangle 10" />
        <Setter Property="Padding"
                Value="12" />
    </Style>


    <!-- =========================
         SELECTION CONTROLS
         ========================= -->

    <Style TargetType="CheckBox">
        <Setter Property="Color"
                Value="{StaticResource Primary}" />
        <Setter Property="MinimumHeightRequest"
                Value="44" />
        <Setter Property="MinimumWidthRequest"
                Value="44" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="BackgroundColor"
                Value="Transparent" />
        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily"
                Value="OpenSansRegular" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="MinimumHeightRequest"
                Value="44" />
        <Setter Property="MinimumWidthRequest"
                Value="44" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor"
                Value="{StaticResource Primary}" />
        <Setter Property="ThumbColor"
                Value="{StaticResource White}" />
    </Style>

    <Style TargetType="Slider">
        <Setter Property="MinimumTrackColor"
                Value="{StaticResource Primary}" />
        <Setter Property="MaximumTrackColor"
                Value="{StaticResource Gray200}" />
        <Setter Property="ThumbColor"
                Value="{StaticResource Primary}" />
    </Style>

    <Style TargetType="IndicatorView">
        <Setter Property="IndicatorColor"
                Value="{StaticResource Gray200}" />
        <Setter Property="SelectedIndicatorColor"
                Value="{StaticResource Primary}" />
    </Style>


    <!-- =========================
         IMAGE BUTTONS
         ========================= -->

    <Style TargetType="ImageButton">
        <Setter Property="BackgroundColor"
                Value="Transparent" />
        <Setter Property="Opacity"
                Value="1" />
        <Setter Property="BorderColor"
                Value="Transparent" />
        <Setter Property="BorderWidth"
                Value="0" />
        <Setter Property="CornerRadius"
                Value="10" />
        <Setter Property="MinimumHeightRequest"
                Value="44" />
        <Setter Property="MinimumWidthRequest"
                Value="44" />

        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">

                    <VisualState x:Name="Normal" />

                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity"
                                    Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="PointerOver" />

                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>


    <!-- =========================
         NAVIGATION
         ========================= -->

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor"
                Value="{StaticResource Primary}" />
        <Setter Property="BarTextColor"
                Value="{StaticResource White}" />
        <Setter Property="IconColor"
                Value="{StaticResource White}" />
    </Style>

    <Style TargetType="Shell"
           ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor"
                Value="{StaticResource Primary}" />
        <Setter Property="Shell.ForegroundColor"
                Value="{StaticResource White}" />
        <Setter Property="Shell.TitleColor"
                Value="{StaticResource White}" />
        <Setter Property="Shell.DisabledColor"
                Value="{StaticResource Gray300}" />
        <Setter Property="Shell.UnselectedColor"
                Value="{StaticResource TextSecondary}" />
        <Setter Property="Shell.NavBarHasShadow"
                Value="False" />

        <Setter Property="Shell.TabBarBackgroundColor"
                Value="{StaticResource White}" />
        <Setter Property="Shell.TabBarForegroundColor"
                Value="{StaticResource Primary}" />
        <Setter Property="Shell.TabBarTitleColor"
                Value="{StaticResource Primary}" />
        <Setter Property="Shell.TabBarUnselectedColor"
                Value="{StaticResource TextSecondary}" />
    </Style>

    <Style TargetType="TabbedPage">
        <Setter Property="BarBackgroundColor"
                Value="{StaticResource White}" />
        <Setter Property="BarTextColor"
                Value="{StaticResource Primary}" />
        <Setter Property="UnselectedTabColor"
                Value="{StaticResource TextSecondary}" />
        <Setter Property="SelectedTabColor"
                Value="{StaticResource Primary}" />
    </Style>

    <Style TargetType="SwipeItem">
        <Setter Property="BackgroundColor"
                Value="{StaticResource White}" />
    </Style>

</ResourceDictionary>