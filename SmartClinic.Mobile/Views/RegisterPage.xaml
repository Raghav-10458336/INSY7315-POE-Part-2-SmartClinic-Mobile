<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SmartClinic.Mobile.Views.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    Title="Create Account"
    BackgroundColor="{StaticResource PageBackground}"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout
            Padding="28,32,28,36"
            Spacing="0"
            MaximumWidthRequest="520"
            HorizontalOptions="Center">

            <!-- Official clinic branding -->
            <Image
                Source="smartclinic_logo.png"
                WidthRequest="150"
                HeightRequest="84"
                Aspect="AspectFit"
                HorizontalOptions="Center"
                SemanticProperties.Description="Doringkloof Medical Centre logo" />

            <Label
                Text="SmartClinic"
                Margin="0,6,0,0"
                FontFamily="OpenSansSemibold"
                FontSize="24"
                TextColor="{StaticResource PrimaryDark}"
                HorizontalTextAlignment="Center" />

            <Label
                Text="Doringkloof Medical Centre"
                Margin="0,3,0,0"
                Style="{StaticResource MutedTextStyle}"
                HorizontalTextAlignment="Center" />

            <!-- Page heading -->
            <VerticalStackLayout
                Margin="0,30,0,0"
                Spacing="7">

                <Label
                    Text="Create your account"
                    Style="{StaticResource PageTitleStyle}"
                    FontSize="24"
                    SemanticProperties.HeadingLevel="Level1" />

                <Label
                    Text="Register for secure access to your appointments and healthcare information."
                    Style="{StaticResource PageSubtitleStyle}"
                    LineHeight="1.25" />

            </VerticalStackLayout>

            <!-- Personal information -->
            <Label
                Text="Personal information"
                Margin="0,26,0,14"
                Style="{StaticResource SectionTitleStyle}"
                FontSize="17"
                SemanticProperties.HeadingLevel="Level2" />

            <!-- First name -->
            <Label
                Text="First name"
                Margin="0,0,0,7"
                Style="{StaticResource FieldLabelStyle}" />

            <Border Style="{StaticResource InputBorderStyle}">
                <Entry
                    Text="{Binding FirstName}"
                    Placeholder="Enter your first name"
                    ReturnType="Next"
                    SemanticProperties.Description="First name" />
            </Border>

            <!-- Last name -->
            <Label
                Text="Last name"
                Margin="0,17,0,7"
                Style="{StaticResource FieldLabelStyle}" />

            <Border Style="{StaticResource InputBorderStyle}">
                <Entry
                    Text="{Binding LastName}"
                    Placeholder="Enter your last name"
                    ReturnType="Next"
                    SemanticProperties.Description="Last name" />
            </Border>

            <!-- Email -->
            <Label
                Text="Email address"
                Margin="0,17,0,7"
                Style="{StaticResource FieldLabelStyle}" />

            <Border Style="{StaticResource InputBorderStyle}">
                <Entry
                    Text="{Binding Email}"
                    Placeholder="Enter your email address"
                    Keyboard="Email"
                    ClearButtonVisibility="WhileEditing"
                    ReturnType="Next"
                    SemanticProperties.Description="Email address" />
            </Border>

            <!-- Phone number -->
            <Label
                Text="Phone number"
                Margin="0,17,0,7"
                Style="{StaticResource FieldLabelStyle}" />

            <Border Style="{StaticResource InputBorderStyle}">
                <Entry
                    Text="{Binding PhoneNumber}"
                    Placeholder="Enter your phone number"
                    Keyboard="Telephone"
                    ReturnType="Next"
                    SemanticProperties.Description="Phone number" />
            </Border>

            <!-- Date of birth -->
            <Label
                Text="Date of birth"
                Margin="0,17,0,7"
                Style="{StaticResource FieldLabelStyle}" />

            <Border Style="{StaticResource InputBorderStyle}">
                <DatePicker
                    Date="{Binding DateOfBirth}"
                    MaximumDate="{x:Static sys:DateTime.Today}"
                    Format="dd MMMM yyyy"
                    SemanticProperties.Description="Date of birth" />
            </Border>

            <!-- Gender -->
            <Label
                Text="Gender"
                Margin="0,17,0,7"
                Style="{StaticResource FieldLabelStyle}" />

            <Border Style="{StaticResource InputBorderStyle}">
                <Picker
                    Title="Select gender"
                    SelectedItem="{Binding Gender}"
                    SemanticProperties.Description="Gender">

                    <Picker.Items>
                        <x:String>Male</x:String>
                        <x:String>Female</x:String>
                        <x:String>Other</x:String>
                        <x:String>Prefer not to say</x:String>
                    </Picker.Items>

                </Picker>
            </Border>

            <!-- Account security -->
            <Label
                Text="Account security"
                Margin="0,28,0,5"
                Style="{StaticResource SectionTitleStyle}"
                FontSize="17"
                SemanticProperties.HeadingLevel="Level2" />

            <Label
                Text="Choose a password with at least 8 characters."
                Margin="0,0,0,14"
                Style="{StaticResource MutedTextStyle}" />

            <!-- Password -->
            <Label
                Text="Password"
                Margin="0,0,0,7"
                Style="{StaticResource FieldLabelStyle}" />

            <Border Style="{StaticResource InputBorderStyle}">
                <Entry
                    Text="{Binding Password}"
                    Placeholder="Minimum 8 characters"
                    IsPassword="True"
                    ReturnType="Next"
                    SemanticProperties.Description="Password, minimum 8 characters" />
            </Border>

            <!-- Confirm password -->
            <Label
                Text="Confirm password"
                Margin="0,17,0,7"
                Style="{StaticResource FieldLabelStyle}" />

            <Border Style="{StaticResource InputBorderStyle}">
                <Entry
                    Text="{Binding ConfirmPassword}"
                    Placeholder="Enter your password again"
                    IsPassword="True"
                    ReturnType="Done"
                    SemanticProperties.Description="Confirm password" />
            </Border>

            <!-- Validation errors -->
            <Border
                Margin="0,18,0,0"
                Style="{StaticResource ErrorBannerStyle}"
                IsVisible="{Binding HasError}">

                <Grid
                    ColumnDefinitions="4,*"
                    ColumnSpacing="10">

                    <BoxView
                        Grid.Column="0"
                        WidthRequest="4"
                        CornerRadius="2"
                        BackgroundColor="{StaticResource Secondary}"
                        VerticalOptions="Fill" />

                    <Label
                        Grid.Column="1"
                        Text="{Binding ErrorMessage}"
                        FontSize="13"
                        TextColor="{StaticResource Error}"
                        LineBreakMode="WordWrap"
                        VerticalTextAlignment="Center"
                        SemanticProperties.Description="Registration error message" />

                </Grid>
            </Border>

            <!-- Successful registration feedback -->
            <Border
                Margin="0,18,0,0"
                Style="{StaticResource SuccessBannerStyle}"
                IsVisible="{Binding HasSuccess}">

                <Grid
                    ColumnDefinitions="4,*"
                    ColumnSpacing="10">

                    <BoxView
                        Grid.Column="0"
                        WidthRequest="4"
                        CornerRadius="2"
                        BackgroundColor="{StaticResource Success}"
                        VerticalOptions="Fill" />

                    <Label
                        Grid.Column="1"
                        Text="{Binding SuccessMessage}"
                        FontSize="13"
                        TextColor="{StaticResource Success}"
                        LineBreakMode="WordWrap"
                        VerticalTextAlignment="Center"
                        SemanticProperties.Description="Registration success message" />

                </Grid>
            </Border>

            <!-- Registration action -->
            <Button
                Text="Create Account"
                Margin="0,24,0,0"
                Style="{StaticResource PrimaryButtonStyle}"
                HeightRequest="52"
                FontSize="16"
                Clicked="OnCreateAccountClicked"
                IsEnabled="{Binding IsNotBusy}"
                SemanticProperties.Description="Create SmartClinic account" />

            <!-- Loading feedback -->
            <HorizontalStackLayout
                Margin="0,15,0,0"
                Spacing="10"
                HorizontalOptions="Center"
                IsVisible="{Binding IsBusy}">

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    WidthRequest="22"
                    HeightRequest="22" />

                <Label
                    Text="Creating your account..."
                    Style="{StaticResource MutedTextStyle}"
                    VerticalTextAlignment="Center"
                    SemanticProperties.Description="Creating your account" />

            </HorizontalStackLayout>

            <!-- Existing login navigation -->
            <HorizontalStackLayout
                Margin="0,27,0,0"
                Spacing="4"
                HorizontalOptions="Center">

                <Label
                    Text="Already have an account?"
                    Style="{StaticResource MutedTextStyle}"
                    FontSize="14"
                    VerticalTextAlignment="Center" />

                <Label
                    Text="Sign in"
                    FontFamily="OpenSansSemibold"
                    FontSize="14"
                    TextColor="{StaticResource Primary}"
                    Padding="4,8"
                    SemanticProperties.Description="Return to sign in">

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="OnSignInTapped" />
                    </Label.GestureRecognizers>

                </Label>
            </HorizontalStackLayout>

            <!-- Security reassurance -->
            <Border
                Margin="0,24,0,0"
                Padding="12,10"
                BackgroundColor="{StaticResource PrimaryLight}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 10">

                <Label
                    Text="Your account provides secure access to your personal healthcare information."
                    FontSize="11"
                    TextColor="{StaticResource TextSecondary}"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="WordWrap" />

            </Border>

            <BoxView
                Margin="0,22,0,0"
                WidthRequest="42"
                HeightRequest="3"
                CornerRadius="2"
                BackgroundColor="{StaticResource Secondary}"
                HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>