<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SmartClinic.Mobile.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Sign In"
    BackgroundColor="{StaticResource PageBackground}"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout
            Padding="28,42,28,30"
            Spacing="0"
            MaximumWidthRequest="520"
            HorizontalOptions="Center">

            <!-- Official Doringkloof Medical Centre branding -->
            <Image
                Source="smartclinic_logo.png"
                WidthRequest="190"
                HeightRequest="108"
                Aspect="AspectFit"
                HorizontalOptions="Center"
                SemanticProperties.Description="Doringkloof Medical Centre logo" />

            <Label
                Text="SmartClinic"
                Margin="0,10,0,0"
                FontFamily="OpenSansSemibold"
                FontSize="28"
                TextColor="{StaticResource PrimaryDark}"
                HorizontalTextAlignment="Center" />

            <Label
                Text="Doringkloof Medical Centre"
                Margin="0,4,0,0"
                Style="{StaticResource MutedTextStyle}"
                HorizontalTextAlignment="Center" />

            <!-- Welcome section -->
            <VerticalStackLayout
                Margin="0,38,0,0"
                Spacing="7">

                <Label
                    Text="Welcome back"
                    Style="{StaticResource PageTitleStyle}"
                    FontSize="24"
                    SemanticProperties.HeadingLevel="Level1" />

                <Label
                    Text="Sign in to manage your appointments and healthcare information."
                    Style="{StaticResource PageSubtitleStyle}"
                    LineHeight="1.25" />

            </VerticalStackLayout>

            <!-- Email -->
            <Label
                Text="Email address"
                Margin="0,26,0,7"
                Style="{StaticResource FieldLabelStyle}" />

            <Border Style="{StaticResource InputBorderStyle}">
                <Entry
                    Text="{Binding Email}"
                    Placeholder="Enter your email address"
                    Keyboard="Email"
                    ClearButtonVisibility="WhileEditing"
                    ReturnType="Next"
                    SemanticProperties.Description="Email address" />
            </Border>

            <!-- Password -->
            <Label
                Text="Password"
                Margin="0,18,0,7"
                Style="{StaticResource FieldLabelStyle}" />

            <Border Style="{StaticResource InputBorderStyle}">
                <Entry
                    Text="{Binding Password}"
                    Placeholder="Enter your password"
                    IsPassword="True"
                    ReturnType="Done"
                    SemanticProperties.Description="Password" />
            </Border>

            <!-- Validation and API feedback -->
            <Border
                Margin="0,16,0,0"
                Style="{StaticResource ErrorBannerStyle}"
                IsVisible="{Binding HasError}">

                <Grid
                    ColumnDefinitions="4,*"
                    ColumnSpacing="10">

                    <!-- Branded error accent -->
                    <BoxView
                        Grid.Column="0"
                        WidthRequest="4"
                        CornerRadius="2"
                        BackgroundColor="{StaticResource Secondary}"
                        VerticalOptions="Fill" />

                    <Label
                        Grid.Column="1"
                        Text="{Binding ErrorMessage}"
                        FontSize="13"
                        TextColor="{StaticResource Error}"
                        LineBreakMode="WordWrap"
                        VerticalTextAlignment="Center"
                        SemanticProperties.Description="Sign in error message" />

                </Grid>
            </Border>

            <!-- Primary sign-in action -->
            <Button
                Text="Sign In"
                Margin="0,24,0,0"
                Style="{StaticResource PrimaryButtonStyle}"
                HeightRequest="52"
                FontSize="16"
                Command="{Binding LoginCommand}"
                IsEnabled="{Binding IsNotBusy}"
                SemanticProperties.Description="Sign in to SmartClinic" />

            <!-- Loading feedback -->
            <HorizontalStackLayout
                Margin="0,15,0,0"
                Spacing="10"
                HorizontalOptions="Center"
                IsVisible="{Binding IsBusy}">

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    WidthRequest="22"
                    HeightRequest="22" />

                <Label
                    Text="Signing you in..."
                    Style="{StaticResource MutedTextStyle}"
                    VerticalTextAlignment="Center"
                    SemanticProperties.Description="Signing in" />

            </HorizontalStackLayout>

            <!-- Registration navigation -->
            <HorizontalStackLayout
                Margin="0,28,0,0"
                Spacing="4"
                HorizontalOptions="Center">

                <Label
                    Text="New to SmartClinic?"
                    Style="{StaticResource MutedTextStyle}"
                    FontSize="14"
                    VerticalTextAlignment="Center" />

                <Label
                    Text="Create account"
                    FontFamily="OpenSansSemibold"
                    FontSize="14"
                    TextColor="{StaticResource Primary}"
                    Padding="4,8"
                    SemanticProperties.Description="Create a SmartClinic account">

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="OnCreateAccountTapped" />
                    </Label.GestureRecognizers>

                </Label>
            </HorizontalStackLayout>

            <!-- Security reassurance -->
            <Border
                Margin="0,30,0,0"
                Padding="12,10"
                BackgroundColor="{StaticResource PrimaryLight}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 10">

                <VerticalStackLayout
                    Spacing="2">

                    <Label
                        Text="Secure patient access"
                        FontFamily="OpenSansSemibold"
                        FontSize="12"
                        TextColor="{StaticResource Primary}"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Your account protects access to your personal healthcare information."
                        FontSize="11"
                        TextColor="{StaticResource TextSecondary}"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap" />

                </VerticalStackLayout>
            </Border>

            <!-- Small red accent ties the screen to the clinic's secondary brand colour -->
            <BoxView
                Margin="0,24,0,0"
                WidthRequest="42"
                HeightRequest="3"
                CornerRadius="2"
                BackgroundColor="{StaticResource Secondary}"
                HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>