<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SmartClinic.Mobile.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Sign In"
    BackgroundColor="#F5F8FA"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout
            Padding="28,60,28,32"
            Spacing="0">

            <!-- Smart Clinic branding -->
            <Border
                WidthRequest="64"
                HeightRequest="64"
                HorizontalOptions="Center"
                BackgroundColor="#E3F2FD"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 18">

                <Label
                    Text="✚"
                    FontSize="32"
                    TextColor="#1565C0"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center" />
            </Border>

            <Label
                Text="Smart Clinic"
                Margin="0,18,0,0"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="#172B4D"
                HorizontalTextAlignment="Center" />

            <Label
                Text="Doringkloof Medical Centre"
                Margin="0,5,0,0"
                FontSize="14"
                TextColor="#6B778C"
                HorizontalTextAlignment="Center" />

            <!-- Welcome section -->
            <Label
                Text="Welcome back"
                Margin="0,48,0,0"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="#172B4D" />

            <Label
                Text="Sign in to manage your appointments and healthcare information."
                Margin="0,8,0,28"
                FontSize="14"
                TextColor="#6B778C"
                LineHeight="1.25" />

            <!-- Email -->
            <Label
                Text="Email address"
                Margin="0,0,0,7"
                FontSize="14"
                FontAttributes="Bold"
                TextColor="#344563" />

            <Border
                Padding="14,4"
                BackgroundColor="White"
                Stroke="#D9E2EC"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10">

                <Entry
                    Text="{Binding Email}"
                    Placeholder="Enter your email address"
                    Keyboard="Email"
                    ClearButtonVisibility="WhileEditing"
                    ReturnType="Next"
                    FontSize="15"
                    TextColor="#172B4D"
                    PlaceholderColor="#8993A4"
                    MinimumHeightRequest="48"
                    SemanticProperties.Description="Email address" />
            </Border>

            <!-- Password -->
            <Label
                Text="Password"
                Margin="0,20,0,7"
                FontSize="14"
                FontAttributes="Bold"
                TextColor="#344563" />

            <Border
                Padding="14,4"
                BackgroundColor="White"
                Stroke="#D9E2EC"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10">

                <Entry
                    Text="{Binding Password}"
                    Placeholder="Enter your password"
                    IsPassword="True"
                    ReturnType="Done"
                    FontSize="15"
                    TextColor="#172B4D"
                    PlaceholderColor="#8993A4"
                    MinimumHeightRequest="48"
                    SemanticProperties.Description="Password" />
            </Border>

            <!-- Validation and API errors -->
            <Border
                Margin="0,16,0,0"
                Padding="12"
                BackgroundColor="#FFEBEE"
                Stroke="#FFCDD2"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8"
                IsVisible="{Binding HasError}">

                <Label
                    Text="{Binding ErrorMessage}"
                    FontSize="13"
                    TextColor="#B71C1C"
                    LineBreakMode="WordWrap"
                    SemanticProperties.Description="Sign in error message" />
            </Border>

            <!-- Sign in -->
            <Button
                Text="Sign In"
                Margin="0,24,0,0"
                HeightRequest="52"
                CornerRadius="10"
                BackgroundColor="#1565C0"
                TextColor="White"
                FontSize="16"
                FontAttributes="Bold"
                Command="{Binding LoginCommand}"
                IsEnabled="{Binding IsNotBusy}"
                SemanticProperties.Description="Sign in" />

            <!-- Loading feedback -->
            <HorizontalStackLayout
                Margin="0,16,0,0"
                Spacing="10"
                HorizontalOptions="Center"
                IsVisible="{Binding IsBusy}">

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    Color="#1565C0"
                    WidthRequest="22"
                    HeightRequest="22" />

                <Label
                    Text="Signing you in..."
                    FontSize="13"
                    TextColor="#6B778C"
                    VerticalTextAlignment="Center" />
            </HorizontalStackLayout>

            <!-- Registration navigation -->
            <HorizontalStackLayout
                Margin="0,30,0,0"
                Spacing="4"
                HorizontalOptions="Center">

                <Label
                    Text="New to Smart Clinic?"
                    FontSize="14"
                    TextColor="#6B778C" />

                <Label
                    Text="Create account"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="#1565C0"
                    SemanticProperties.Description="Create account">

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="OnCreateAccountTapped" />
                    </Label.GestureRecognizers>

                </Label>

            </HorizontalStackLayout>

            <Label
                Text="Secure patient access"
                Margin="0,40,0,0"
                FontSize="12"
                TextColor="#8993A4"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>