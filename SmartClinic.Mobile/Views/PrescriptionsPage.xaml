<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SmartClinic.Mobile.Views.PrescriptionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:SmartClinic.Mobile.Models"
    Title="My Prescriptions"
    BackgroundColor="#F5F8FA">

    <Grid
        Padding="24,24,24,30"
        RowDefinitions="Auto,Auto,*">

        <!-- Page heading -->
        <VerticalStackLayout
            Grid.Row="0"
            Spacing="5">

            <Label
                Text="My Prescriptions"
                FontSize="26"
                FontAttributes="Bold"
                TextColor="#172B4D" />

            <Label
                Text="Review medication prescribed during your clinic consultations."
                FontSize="14"
                TextColor="#6B778C"
                LineBreakMode="WordWrap" />

        </VerticalStackLayout>

        <!-- Loading and error feedback -->
        <VerticalStackLayout
            Grid.Row="1"
            Margin="0,18,0,0"
            Spacing="12">

            <HorizontalStackLayout
                Spacing="10"
                IsVisible="{Binding IsBusy}">

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    WidthRequest="22"
                    HeightRequest="22"
                    Color="#1565C0" />

                <Label
                    Text="Loading prescriptions..."
                    FontSize="13"
                    TextColor="#6B778C"
                    VerticalTextAlignment="Center" />

            </HorizontalStackLayout>

            <Border
                Padding="12"
                BackgroundColor="#FFEBEE"
                Stroke="#FFCDD2"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8"
                IsVisible="{Binding HasError}">

                <Label
                    Text="{Binding ErrorMessage}"
                    FontSize="13"
                    TextColor="#B71C1C"
                    LineBreakMode="WordWrap"
                    AutomationProperties.Name="Prescriptions error message" />

            </Border>

        </VerticalStackLayout>

        <!-- Prescription content -->
        <Grid
            Grid.Row="2"
            Margin="0,20,0,0">

            <!-- Empty state -->
            <Border
                Padding="26"
                VerticalOptions="Start"
                BackgroundColor="White"
                Stroke="#D9E2EC"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14"
                IsVisible="{Binding HasNoPrescriptions}">

                <VerticalStackLayout
                    Spacing="10"
                    HorizontalOptions="Center">

                    <Label
                        Text="💊"
                        FontSize="34"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="No prescriptions yet"
                        FontSize="17"
                        FontAttributes="Bold"
                        TextColor="#172B4D"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Medication prescribed during your consultations will appear here."
                        FontSize="13"
                        TextColor="#6B778C"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap" />

                </VerticalStackLayout>

            </Border>

            <!-- Prescription list -->
            <CollectionView
                ItemsSource="{Binding Prescriptions}"
                IsVisible="{Binding HasPrescriptions}"
                SelectionMode="None">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout
                        Orientation="Vertical"
                        ItemSpacing="12" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Prescription">

                        <Border
                            Padding="18"
                            BackgroundColor="White"
                            Stroke="#D9E2EC"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14">

                            <VerticalStackLayout Spacing="14">

                                <!-- Medication and status -->
                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="12">

                                    <VerticalStackLayout
                                        Grid.Column="0"
                                        Spacing="3">

                                        <Label
                                            Text="{Binding MedicationName}"
                                            FontSize="18"
                                            FontAttributes="Bold"
                                            TextColor="#172B4D" />

                                        <Label
                                            Text="{Binding Dosage}"
                                            FontSize="13"
                                            FontAttributes="Bold"
                                            TextColor="#1565C0" />

                                    </VerticalStackLayout>

                                    <Border
                                        Grid.Column="1"
                                        Padding="9,5"
                                        VerticalOptions="Start"
                                        BackgroundColor="#E8F5E9"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8">

                                        <Label
                                            Text="PRESCRIBED"
                                            FontSize="10"
                                            FontAttributes="Bold"
                                            TextColor="#2E7D32" />

                                    </Border>

                                </Grid>

                                <!-- Doctor -->
                                <VerticalStackLayout Spacing="3">

                                    <Label
                                        Text="Prescribed by"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        TextColor="#6B778C" />

                                    <Label
                                        Text="{Binding DoctorName}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="#172B4D" />

                                </VerticalStackLayout>

                                <!-- Frequency and duration -->
                                <Grid
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="12">

                                    <VerticalStackLayout
                                        Grid.Column="0"
                                        Spacing="3">

                                        <Label
                                            Text="Frequency"
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            TextColor="#6B778C" />

                                        <Label
                                            Text="{Binding Frequency}"
                                            FontSize="13"
                                            TextColor="#172B4D"
                                            LineBreakMode="WordWrap" />

                                    </VerticalStackLayout>

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="3">

                                        <Label
                                            Text="Duration"
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            TextColor="#6B778C" />

                                        <Label
                                            Text="{Binding Duration}"
                                            FontSize="13"
                                            TextColor="#172B4D"
                                            LineBreakMode="WordWrap" />

                                    </VerticalStackLayout>

                                </Grid>

                                <!-- Medication instructions -->
                                <Border
                                    Padding="12"
                                    BackgroundColor="#F5F8FA"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8">

                                    <VerticalStackLayout Spacing="4">

                                        <Label
                                            Text="Instructions"
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            TextColor="#6B778C" />

                                        <Label
                                            Text="{Binding Instructions}"
                                            FontSize="13"
                                            TextColor="#44546A"
                                            LineBreakMode="WordWrap" />

                                    </VerticalStackLayout>

                                </Border>

                                <!-- Issued and expiry dates -->
                                <Grid
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="12">

                                    <VerticalStackLayout
                                        Grid.Column="0"
                                        Spacing="3">

                                        <Label
                                            Text="Issued"
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            TextColor="#6B778C" />

                                        <Label
                                            Text="{Binding IssuedDate, StringFormat='{0:dd MMM yyyy}'}"
                                            FontSize="13"
                                            TextColor="#172B4D" />

                                    </VerticalStackLayout>

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="3">

                                        <Label
                                            Text="Expiry"
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            TextColor="#6B778C" />

                                        <Label
                                            Text="{Binding ExpiryDate, StringFormat='{0:dd MMM yyyy}'}"
                                            FontSize="13"
                                            TextColor="#172B4D" />

                                    </VerticalStackLayout>

                                </Grid>

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </Grid>

    </Grid>

</ContentPage>