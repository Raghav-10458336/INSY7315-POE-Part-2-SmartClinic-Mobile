<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SmartClinic.Mobile.Views.PrescriptionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:SmartClinic.Mobile.Models"
    Title="My Prescriptions"
    BackgroundColor="{StaticResource PageBackground}">

    <Grid
        Padding="24,24,24,30"
        RowDefinitions="Auto,Auto,*"
        MaximumWidthRequest="620"
        HorizontalOptions="Center">

        <!-- Page heading -->
        <VerticalStackLayout
            Grid.Row="0"
            Spacing="5">

            <Label
                Text="My Prescriptions"
                Style="{StaticResource PageTitleStyle}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Review medication prescribed during your clinic consultations."
                Style="{StaticResource PageSubtitleStyle}"
                LineBreakMode="WordWrap" />

        </VerticalStackLayout>

        <!-- Loading and error feedback -->
        <VerticalStackLayout
            Grid.Row="1"
            Margin="0,18,0,0"
            Spacing="12">

            <HorizontalStackLayout
                Spacing="10"
                IsVisible="{Binding IsBusy}">

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    WidthRequest="22"
                    HeightRequest="22" />

                <Label
                    Text="Loading prescriptions..."
                    Style="{StaticResource MutedTextStyle}"
                    VerticalTextAlignment="Center"
                    SemanticProperties.Description="Loading prescriptions" />

            </HorizontalStackLayout>

            <Border
                Style="{StaticResource ErrorBannerStyle}"
                IsVisible="{Binding HasError}">

                <Grid
                    ColumnDefinitions="4,*"
                    ColumnSpacing="10">

                    <BoxView
                        Grid.Column="0"
                        WidthRequest="4"
                        CornerRadius="2"
                        BackgroundColor="{StaticResource Secondary}"
                        VerticalOptions="Fill" />

                    <Label
                        Grid.Column="1"
                        Text="{Binding ErrorMessage}"
                        FontSize="13"
                        TextColor="{StaticResource Error}"
                        LineBreakMode="WordWrap"
                        VerticalTextAlignment="Center"
                        SemanticProperties.Description="Prescriptions error message" />

                </Grid>

            </Border>

        </VerticalStackLayout>

        <!-- Prescription content -->
        <Grid
            Grid.Row="2"
            Margin="0,20,0,0">

            <!-- Empty state -->
            <Border
                Padding="28,30"
                VerticalOptions="Start"
                Style="{StaticResource CardStyle}"
                IsVisible="{Binding HasNoPrescriptions}">

                <VerticalStackLayout
                    Spacing="10"
                    HorizontalOptions="Center">

                    <Border
                        WidthRequest="54"
                        HeightRequest="54"
                        BackgroundColor="{StaticResource PrimaryLight}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16">

                        <Label
                            Text="Rx"
                            FontFamily="OpenSansSemibold"
                            FontSize="15"
                            TextColor="{StaticResource Primary}"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />

                    </Border>

                    <Label
                        Text="No prescriptions yet"
                        Margin="0,4,0,0"
                        Style="{StaticResource CardTitleStyle}"
                        FontSize="17"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Medication prescribed during your consultations will appear here."
                        Style="{StaticResource MutedTextStyle}"
                        FontSize="13"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap" />

                </VerticalStackLayout>

            </Border>

            <!-- Prescription list -->
            <CollectionView
                ItemsSource="{Binding Prescriptions}"
                IsVisible="{Binding HasPrescriptions}"
                SelectionMode="None">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout
                        Orientation="Vertical"
                        ItemSpacing="12" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Prescription">

                        <Border Style="{StaticResource CardStyle}">

                            <VerticalStackLayout Spacing="14">

                                <!-- Medication and status -->
                                <Grid
                                    ColumnDefinitions="Auto,*,Auto"
                                    ColumnSpacing="11">

                                    <Border
                                        Grid.Column="0"
                                        WidthRequest="42"
                                        HeightRequest="42"
                                        VerticalOptions="Start"
                                        BackgroundColor="{StaticResource PrimaryLight}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 11">

                                        <Label
                                            Text="Rx"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="12"
                                            TextColor="{StaticResource Primary}"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center" />

                                    </Border>

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="3"
                                        VerticalOptions="Center">

                                        <Label
                                            Text="{Binding MedicationName}"
                                            Style="{StaticResource CardTitleStyle}"
                                            FontSize="17" />

                                        <Label
                                            Text="{Binding Dosage}"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="13"
                                            TextColor="{StaticResource Primary}" />

                                    </VerticalStackLayout>

                                    <Border
                                        Grid.Column="2"
                                        Padding="8,5"
                                        VerticalOptions="Start"
                                        BackgroundColor="{StaticResource SuccessLight}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8">

                                        <Label
                                            Text="PRESCRIBED"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="9"
                                            TextColor="{StaticResource Success}" />

                                    </Border>

                                </Grid>

                                <BoxView
                                    HeightRequest="1"
                                    BackgroundColor="{StaticResource Divider}" />

                                <!-- Prescribing doctor -->
                                <VerticalStackLayout Spacing="4">

                                    <Label
                                        Text="PRESCRIBED BY"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="10"
                                        TextColor="{StaticResource TextSecondary}" />

                                    <Label
                                        Text="{Binding DoctorName}"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="14"
                                        TextColor="{StaticResource TextPrimary}" />

                                </VerticalStackLayout>

                                <!-- Frequency and duration -->
                                <Grid
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="12">

                                    <Border
                                        Grid.Column="0"
                                        Padding="13"
                                        BackgroundColor="{StaticResource SurfaceMuted}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10">

                                        <VerticalStackLayout Spacing="4">

                                            <Label
                                                Text="FREQUENCY"
                                                FontFamily="OpenSansSemibold"
                                                FontSize="10"
                                                TextColor="{StaticResource TextSecondary}" />

                                            <Label
                                                Text="{Binding Frequency}"
                                                FontSize="13"
                                                TextColor="{StaticResource TextPrimary}"
                                                LineBreakMode="WordWrap" />

                                        </VerticalStackLayout>

                                    </Border>

                                    <Border
                                        Grid.Column="1"
                                        Padding="13"
                                        BackgroundColor="{StaticResource SurfaceMuted}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10">

                                        <VerticalStackLayout Spacing="4">

                                            <Label
                                                Text="DURATION"
                                                FontFamily="OpenSansSemibold"
                                                FontSize="10"
                                                TextColor="{StaticResource TextSecondary}" />

                                            <Label
                                                Text="{Binding Duration}"
                                                FontSize="13"
                                                TextColor="{StaticResource TextPrimary}"
                                                LineBreakMode="WordWrap" />

                                        </VerticalStackLayout>

                                    </Border>

                                </Grid>

                                <!-- Medication instructions -->
                                <Border
                                    Padding="13"
                                    BackgroundColor="{StaticResource PrimaryLight}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10">

                                    <VerticalStackLayout Spacing="5">

                                        <Label
                                            Text="INSTRUCTIONS"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="10"
                                            TextColor="{StaticResource Primary}" />

                                        <Label
                                            Text="{Binding Instructions}"
                                            Style="{StaticResource BodyTextStyle}"
                                            FontSize="13"
                                            LineBreakMode="WordWrap" />

                                    </VerticalStackLayout>

                                </Border>

                                <!-- Issued and expiry dates -->
                                <Grid
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="12">

                                    <VerticalStackLayout
                                        Grid.Column="0"
                                        Spacing="3">

                                        <Label
                                            Text="ISSUED"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="10"
                                            TextColor="{StaticResource TextSecondary}" />

                                        <Label
                                            Text="{Binding IssuedDate, StringFormat='{0:dd MMM yyyy}'}"
                                            FontSize="12"
                                            TextColor="{StaticResource TextPrimary}" />

                                    </VerticalStackLayout>

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="3">

                                        <Label
                                            Text="EXPIRY"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="10"
                                            TextColor="{StaticResource TextSecondary}" />

                                        <Label
                                            Text="{Binding ExpiryDate, StringFormat='{0:dd MMM yyyy}'}"
                                            FontSize="12"
                                            TextColor="{StaticResource TextPrimary}" />

                                    </VerticalStackLayout>

                                </Grid>

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </Grid>

    </Grid>

</ContentPage>