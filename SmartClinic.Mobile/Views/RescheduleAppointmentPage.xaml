<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SmartClinic.Mobile.Views.RescheduleAppointmentPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:SmartClinic.Mobile.Models"
    Title="Reschedule Appointment"
    BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>
        <VerticalStackLayout
            Padding="24,24,24,40"
            Spacing="0"
            MaximumWidthRequest="620"
            HorizontalOptions="Center">

            <!-- Page heading -->
            <Label
                Text="Reschedule Appointment"
                Style="{StaticResource PageTitleStyle}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Choose a new available time for your appointment."
                Margin="0,5,0,0"
                Style="{StaticResource PageSubtitleStyle}"
                LineBreakMode="WordWrap" />

            <!-- Current appointment -->
            <Label
                Text="Current appointment"
                Margin="0,28,0,10"
                Style="{StaticResource SectionTitleStyle}"
                SemanticProperties.HeadingLevel="Level2" />

            <Border Style="{StaticResource CardStyle}">

                <VerticalStackLayout Spacing="12">

                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="13">

                        <Border
                            Grid.Column="0"
                            WidthRequest="44"
                            HeightRequest="44"
                            VerticalOptions="Start"
                            BackgroundColor="{StaticResource PrimaryLight}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12">

                            <Label
                                Text="DR"
                                FontFamily="OpenSansSemibold"
                                FontSize="12"
                                TextColor="{StaticResource Primary}"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />

                        </Border>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="3"
                            VerticalOptions="Center">

                            <Label
                                Text="{Binding Appointment.DoctorName}"
                                Style="{StaticResource CardTitleStyle}"
                                FontSize="17" />

                            <Label
                                Text="{Binding Appointment.DoctorSpecialisation}"
                                FontSize="13"
                                TextColor="{StaticResource Primary}" />

                        </VerticalStackLayout>

                    </Grid>

                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="{StaticResource Divider}" />

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="12">

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="3">

                            <Label
                                Text="CURRENT DATE"
                                FontFamily="OpenSansSemibold"
                                FontSize="11"
                                TextColor="{StaticResource TextSecondary}" />

                            <Label
                                Text="{Binding Appointment.AppointmentDateTime, StringFormat='{0:dd MMM yyyy}'}"
                                FontSize="14"
                                TextColor="{StaticResource TextPrimary}" />

                        </VerticalStackLayout>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="3">

                            <Label
                                Text="CURRENT TIME"
                                FontFamily="OpenSansSemibold"
                                FontSize="11"
                                TextColor="{StaticResource TextSecondary}" />

                            <Label
                                Text="{Binding Appointment.AppointmentDateTime, StringFormat='{0:HH:mm}'}"
                                FontSize="14"
                                TextColor="{StaticResource TextPrimary}" />

                        </VerticalStackLayout>

                    </Grid>

                </VerticalStackLayout>

            </Border>

            <!-- Loading feedback -->
            <HorizontalStackLayout
                Margin="0,18,0,0"
                Spacing="10"
                IsVisible="{Binding IsBusy}">

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    WidthRequest="22"
                    HeightRequest="22" />

                <Label
                    Text="Updating appointment..."
                    Style="{StaticResource MutedTextStyle}"
                    VerticalTextAlignment="Center"
                    SemanticProperties.Description="Updating appointment" />

            </HorizontalStackLayout>

            <!-- Error feedback -->
            <Border
                Margin="0,18,0,0"
                Style="{StaticResource ErrorBannerStyle}"
                IsVisible="{Binding HasError}">

                <Grid
                    ColumnDefinitions="4,*"
                    ColumnSpacing="10">

                    <BoxView
                        Grid.Column="0"
                        WidthRequest="4"
                        CornerRadius="2"
                        BackgroundColor="{StaticResource Secondary}"
                        VerticalOptions="Fill" />

                    <Label
                        Grid.Column="1"
                        Text="{Binding ErrorMessage}"
                        FontSize="13"
                        TextColor="{StaticResource Error}"
                        LineBreakMode="WordWrap"
                        VerticalTextAlignment="Center"
                        SemanticProperties.Description="Reschedule appointment error message" />

                </Grid>

            </Border>

            <!-- New appointment time -->
            <Label
                Text="Select a new time"
                Margin="0,28,0,6"
                Style="{StaticResource SectionTitleStyle}"
                SemanticProperties.HeadingLevel="Level2" />

            <Label
                Text="Available times for your current doctor are shown below."
                Style="{StaticResource MutedTextStyle}"
                LineBreakMode="WordWrap" />

            <CollectionView
                Margin="0,12,0,0"
                ItemsSource="{Binding AvailableSlots}"
                IsVisible="{Binding HasAvailableSlots}"
                SelectedItem="{Binding SelectedSlot}"
                SelectionMode="Single"
                HeightRequest="230">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout
                        Orientation="Vertical"
                        ItemSpacing="8" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:DoctorAvailability">

                        <Border
                            Padding="14"
                            BackgroundColor="{StaticResource Surface}"
                            Stroke="{StaticResource Border}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10">

                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="12">

                                <VerticalStackLayout
                                    Grid.Column="0"
                                    Spacing="3">

                                    <Label
                                        Text="{Binding StartDateTime, StringFormat='{0:dddd, dd MMM yyyy}'}"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="14"
                                        TextColor="{StaticResource TextPrimary}" />

                                    <Label
                                        Text="{Binding StartDateTime, StringFormat='{0:HH:mm}'}"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="13"
                                        TextColor="{StaticResource Primary}" />

                                </VerticalStackLayout>

                                <Border
                                    Grid.Column="1"
                                    Padding="9,5"
                                    VerticalOptions="Center"
                                    BackgroundColor="{StaticResource SuccessLight}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8">

                                    <Label
                                        Text="Available"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="10"
                                        TextColor="{StaticResource Success}" />

                                </Border>

                            </Grid>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <!-- Selection guidance -->
            <Border
                Margin="0,12,0,0"
                Padding="12"
                BackgroundColor="{StaticResource InfoLight}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 10">

                <Label
                    Text="Select your preferred replacement time before confirming the change."
                    FontSize="12"
                    TextColor="{StaticResource Info}"
                    LineBreakMode="WordWrap" />

            </Border>

            <!-- Success feedback -->
            <Border
                Margin="0,18,0,0"
                Style="{StaticResource SuccessBannerStyle}"
                IsVisible="{Binding HasSuccess}">

                <Grid
                    ColumnDefinitions="4,*"
                    ColumnSpacing="10">

                    <BoxView
                        Grid.Column="0"
                        WidthRequest="4"
                        CornerRadius="2"
                        BackgroundColor="{StaticResource Success}"
                        VerticalOptions="Fill" />

                    <Label
                        Grid.Column="1"
                        Text="{Binding SuccessMessage}"
                        FontSize="13"
                        TextColor="{StaticResource Success}"
                        LineBreakMode="WordWrap"
                        VerticalTextAlignment="Center"
                        SemanticProperties.Description="Reschedule appointment success message" />

                </Grid>

            </Border>

            <!-- Confirm action -->
            <Button
                Text="Confirm New Appointment Time"
                Margin="0,24,0,0"
                Style="{StaticResource PrimaryButtonStyle}"
                Command="{Binding RescheduleAppointmentCommand}"
                IsEnabled="{Binding IsNotBusy}"
                SemanticProperties.Description="Confirm new appointment time" />

            <!-- Reassurance -->
            <Border
                Margin="0,14,0,0"
                Padding="12"
                BackgroundColor="{StaticResource SurfaceMuted}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 10">

                <Label
                    Text="Your existing appointment remains unchanged until the new time is successfully confirmed."
                    Style="{StaticResource MutedTextStyle}"
                    FontSize="11"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="WordWrap" />

            </Border>

            <!-- Clinic brand accent -->
            <BoxView
                Margin="0,26,0,0"
                WidthRequest="42"
                HeightRequest="3"
                CornerRadius="2"
                BackgroundColor="{StaticResource Secondary}"
                HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>