<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SmartClinic.Mobile.Views.CheckInQueuePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Check In"
    BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>
        <VerticalStackLayout
            Padding="24,24,24,40"
            Spacing="0"
            MaximumWidthRequest="620"
            HorizontalOptions="Center">

            <!-- Page heading -->
            <Label
                Text="Clinic Check-In"
                Style="{StaticResource PageTitleStyle}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Check in for your appointment and follow your queue status."
                Margin="0,5,0,0"
                Style="{StaticResource PageSubtitleStyle}"
                LineBreakMode="WordWrap" />

            <!-- Appointment summary -->
            <Label
                Text="Today's appointment"
                Margin="0,28,0,10"
                Style="{StaticResource SectionTitleStyle}"
                SemanticProperties.HeadingLevel="Level2" />

            <Border Style="{StaticResource CardStyle}">

                <VerticalStackLayout Spacing="12">

                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="13">

                        <Border
                            Grid.Column="0"
                            WidthRequest="44"
                            HeightRequest="44"
                            VerticalOptions="Start"
                            BackgroundColor="{StaticResource PrimaryLight}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12">

                            <Label
                                Text="DR"
                                FontFamily="OpenSansSemibold"
                                FontSize="12"
                                TextColor="{StaticResource Primary}"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />

                        </Border>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="3"
                            VerticalOptions="Center">

                            <Label
                                Text="{Binding Appointment.DoctorName}"
                                Style="{StaticResource CardTitleStyle}"
                                FontSize="17" />

                            <Label
                                Text="{Binding Appointment.DoctorSpecialisation}"
                                FontSize="13"
                                TextColor="{StaticResource Primary}" />

                        </VerticalStackLayout>

                    </Grid>

                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="{StaticResource Divider}" />

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="12">

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="3">

                            <Label
                                Text="DATE"
                                FontFamily="OpenSansSemibold"
                                FontSize="11"
                                TextColor="{StaticResource TextSecondary}" />

                            <Label
                                Text="{Binding Appointment.AppointmentDateTime, StringFormat='{0:dd MMM yyyy}'}"
                                FontSize="14"
                                TextColor="{StaticResource TextPrimary}" />

                        </VerticalStackLayout>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="3">

                            <Label
                                Text="TIME"
                                FontFamily="OpenSansSemibold"
                                FontSize="11"
                                TextColor="{StaticResource TextSecondary}" />

                            <Label
                                Text="{Binding Appointment.AppointmentDateTime, StringFormat='{0:HH:mm}'}"
                                FontSize="14"
                                TextColor="{StaticResource TextPrimary}" />

                        </VerticalStackLayout>

                    </Grid>

                </VerticalStackLayout>

            </Border>

            <!-- Loading feedback -->
            <HorizontalStackLayout
                Margin="0,18,0,0"
                Spacing="10"
                IsVisible="{Binding IsBusy}">

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    WidthRequest="22"
                    HeightRequest="22" />

                <Label
                    Text="Updating clinic status..."
                    Style="{StaticResource MutedTextStyle}"
                    VerticalTextAlignment="Center"
                    SemanticProperties.Description="Updating clinic queue status" />

            </HorizontalStackLayout>

            <!-- Error feedback -->
            <Border
                Margin="0,18,0,0"
                Style="{StaticResource ErrorBannerStyle}"
                IsVisible="{Binding HasError}">

                <Grid
                    ColumnDefinitions="4,*"
                    ColumnSpacing="10">

                    <BoxView
                        Grid.Column="0"
                        WidthRequest="4"
                        CornerRadius="2"
                        BackgroundColor="{StaticResource Secondary}"
                        VerticalOptions="Fill" />

                    <Label
                        Grid.Column="1"
                        Text="{Binding ErrorMessage}"
                        FontSize="13"
                        TextColor="{StaticResource Error}"
                        LineBreakMode="WordWrap"
                        VerticalTextAlignment="Center"
                        SemanticProperties.Description="Check-in error message" />

                </Grid>

            </Border>

            <!-- Success feedback -->
            <Border
                Margin="0,18,0,0"
                Style="{StaticResource SuccessBannerStyle}"
                IsVisible="{Binding HasSuccess}">

                <Grid
                    ColumnDefinitions="4,*"
                    ColumnSpacing="10">

                    <BoxView
                        Grid.Column="0"
                        WidthRequest="4"
                        CornerRadius="2"
                        BackgroundColor="{StaticResource Success}"
                        VerticalOptions="Fill" />

                    <Label
                        Grid.Column="1"
                        Text="{Binding SuccessMessage}"
                        FontSize="13"
                        TextColor="{StaticResource Success}"
                        LineBreakMode="WordWrap"
                        VerticalTextAlignment="Center"
                        SemanticProperties.Description="Check-in success message" />

                </Grid>

            </Border>

            <!-- Check-in action -->
            <Border
                Margin="0,22,0,0"
                Style="{StaticResource CardStyle}"
                IsVisible="{Binding CanCheckIn}">

                <VerticalStackLayout Spacing="14">

                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="13">

                        <Border
                            Grid.Column="0"
                            WidthRequest="44"
                            HeightRequest="44"
                            VerticalOptions="Start"
                            BackgroundColor="{StaticResource SuccessLight}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12">

                            <Label
                                Text="IN"
                                FontFamily="OpenSansSemibold"
                                FontSize="12"
                                TextColor="{StaticResource Success}"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />

                        </Border>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="4"
                            VerticalOptions="Center">

                            <Label
                                Text="Ready to check in?"
                                Style="{StaticResource CardTitleStyle}"
                                FontSize="17" />

                            <Label
                                Text="Confirm your arrival at the clinic to join the appointment queue."
                                Style="{StaticResource MutedTextStyle}"
                                FontSize="13"
                                LineBreakMode="WordWrap" />

                        </VerticalStackLayout>

                    </Grid>

                    <Button
                        Text="Check In Now"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Clicked="OnCheckInClicked"
                        IsEnabled="{Binding IsNotBusy}"
                        SemanticProperties.Description="Check in for appointment" />

                </VerticalStackLayout>

            </Border>

            <!-- Live queue information -->
            <Border
                Margin="0,22,0,0"
                Style="{StaticResource CardStyle}"
                IsVisible="{Binding HasQueueStatus}">

                <VerticalStackLayout Spacing="16">

                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="12">

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="3">

                            <Label
                                Text="Queue Status"
                                Style="{StaticResource CardTitleStyle}"
                                FontSize="18"
                                SemanticProperties.HeadingLevel="Level2" />

                            <Label
                                Text="Live information from the clinic queue."
                                Style="{StaticResource MutedTextStyle}"
                                FontSize="12" />

                        </VerticalStackLayout>

                        <Border
                            Grid.Column="1"
                            Padding="10,6"
                            VerticalOptions="Start"
                            BackgroundColor="{StaticResource SuccessLight}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 8">

                            <Label
                                Text="{Binding QueueStatus.Status}"
                                FontFamily="OpenSansSemibold"
                                FontSize="11"
                                TextColor="{StaticResource Success}" />

                        </Border>

                    </Grid>

                    <!-- Prominent queue position -->
                    <Border
                        Padding="20"
                        BackgroundColor="{StaticResource PrimaryLight}"
                        Stroke="{StaticResource Primary}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14">

                        <VerticalStackLayout
                            Spacing="4"
                            HorizontalOptions="Center">

                            <Label
                                Text="YOUR QUEUE POSITION"
                                FontFamily="OpenSansSemibold"
                                FontSize="11"
                                TextColor="{StaticResource Primary}"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Text="{Binding QueueStatus.QueuePosition}"
                                FontFamily="OpenSansSemibold"
                                FontSize="40"
                                TextColor="{StaticResource TextPrimary}"
                                HorizontalTextAlignment="Center"
                                SemanticProperties.Description="Current queue position" />

                        </VerticalStackLayout>

                    </Border>

                    <!-- Queue details -->
                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="12">

                        <Border
                            Grid.Column="0"
                            Padding="14"
                            BackgroundColor="{StaticResource SurfaceMuted}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10">

                            <VerticalStackLayout Spacing="3">

                                <Label
                                    Text="ESTIMATED WAIT"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="10"
                                    TextColor="{StaticResource TextSecondary}" />

                                <Label
                                    Text="{Binding QueueStatus.EstimatedWaitTime}"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="15"
                                    TextColor="{StaticResource TextPrimary}" />

                            </VerticalStackLayout>

                        </Border>

                        <Border
                            Grid.Column="1"
                            Padding="14"
                            BackgroundColor="{StaticResource SurfaceMuted}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10">

                            <VerticalStackLayout Spacing="3">

                                <Label
                                    Text="CHECKED IN"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="10"
                                    TextColor="{StaticResource TextSecondary}" />

                                <Label
                                    Text="{Binding QueueStatus.CheckedInAt, StringFormat='{0:HH:mm}'}"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="15"
                                    TextColor="{StaticResource TextPrimary}" />

                            </VerticalStackLayout>

                        </Border>

                    </Grid>

                    <Button
                        Text="Refresh Queue Status"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding RefreshQueueCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        SemanticProperties.Description="Refresh queue status" />

                </VerticalStackLayout>

            </Border>

            <!-- Queue guidance -->
            <Border
                Margin="0,14,0,0"
                Style="{StaticResource WarningBannerStyle}"
                IsVisible="{Binding HasQueueStatus}">

                <Grid
                    ColumnDefinitions="4,*"
                    ColumnSpacing="10">

                    <BoxView
                        Grid.Column="0"
                        WidthRequest="4"
                        CornerRadius="2"
                        BackgroundColor="{StaticResource Warning}"
                        VerticalOptions="Fill" />

                    <Label
                        Grid.Column="1"
                        Text="Please remain near the clinic waiting area and refresh your queue status for the latest information."
                        FontSize="12"
                        TextColor="{StaticResource Warning}"
                        LineBreakMode="WordWrap"
                        VerticalTextAlignment="Center" />

                </Grid>

            </Border>

            <!-- Queue privacy reassurance -->
            <Border
                Margin="0,18,0,0"
                Padding="12"
                BackgroundColor="{StaticResource SurfaceMuted}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 10">

                <Label
                    Text="Your queue information is linked securely to your clinic appointment."
                    Style="{StaticResource MutedTextStyle}"
                    FontSize="11"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="WordWrap" />

            </Border>

            <!-- Clinic brand accent -->
            <BoxView
                Margin="0,26,0,0"
                WidthRequest="42"
                HeightRequest="3"
                CornerRadius="2"
                BackgroundColor="{StaticResource Secondary}"
                HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>