<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SmartClinic.Mobile.Views.ConsultationDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:SmartClinic.Mobile.Models"
    Title="Consultation Details"
    BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>
        <VerticalStackLayout
            Padding="24,24,24,40"
            Spacing="0"
            MaximumWidthRequest="620"
            HorizontalOptions="Center">

            <!-- Page heading -->
            <Label
                Text="Consultation Details"
                Style="{StaticResource PageTitleStyle}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Review the clinical information recorded during your consultation."
                Margin="0,5,0,0"
                Style="{StaticResource PageSubtitleStyle}"
                LineBreakMode="WordWrap" />

            <!-- Loading feedback -->
            <HorizontalStackLayout
                Margin="0,18,0,0"
                Spacing="10"
                IsVisible="{Binding IsBusy}">

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    WidthRequest="22"
                    HeightRequest="22" />

                <Label
                    Text="Loading consultation details..."
                    Style="{StaticResource MutedTextStyle}"
                    VerticalTextAlignment="Center"
                    SemanticProperties.Description="Loading consultation details" />

            </HorizontalStackLayout>

            <!-- Error feedback -->
            <Border
                Margin="0,18,0,0"
                Style="{StaticResource ErrorBannerStyle}"
                IsVisible="{Binding HasError}">

                <Grid
                    ColumnDefinitions="4,*"
                    ColumnSpacing="10">

                    <BoxView
                        Grid.Column="0"
                        WidthRequest="4"
                        CornerRadius="2"
                        BackgroundColor="{StaticResource Secondary}"
                        VerticalOptions="Fill" />

                    <Label
                        Grid.Column="1"
                        Text="{Binding ErrorMessage}"
                        FontSize="13"
                        TextColor="{StaticResource Error}"
                        LineBreakMode="WordWrap"
                        VerticalTextAlignment="Center"
                        SemanticProperties.Description="Consultation details error message" />

                </Grid>

            </Border>

            <!-- Consultation overview -->
            <Label
                Text="Clinical record"
                Margin="0,28,0,10"
                Style="{StaticResource SectionTitleStyle}"
                SemanticProperties.HeadingLevel="Level2" />

            <Border Style="{StaticResource CardStyle}">

                <VerticalStackLayout Spacing="14">

                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="12">

                        <Border
                            Grid.Column="0"
                            WidthRequest="44"
                            HeightRequest="44"
                            VerticalOptions="Start"
                            BackgroundColor="{StaticResource PrimaryLight}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12">

                            <Label
                                Text="DR"
                                FontFamily="OpenSansSemibold"
                                FontSize="12"
                                TextColor="{StaticResource Primary}"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />

                        </Border>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="3"
                            VerticalOptions="Center">

                            <Label
                                Text="{Binding Consultation.DoctorName}"
                                Style="{StaticResource CardTitleStyle}"
                                FontSize="17" />

                            <Label
                                Text="Consulting Doctor"
                                FontSize="12"
                                TextColor="{StaticResource Primary}" />

                        </VerticalStackLayout>

                        <Border
                            Grid.Column="2"
                            Padding="9,5"
                            VerticalOptions="Start"
                            BackgroundColor="{StaticResource SuccessLight}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 8">

                            <Label
                                Text="{Binding Consultation.ConsultationDate, StringFormat='{0:dd MMM yyyy}'}"
                                FontFamily="OpenSansSemibold"
                                FontSize="10"
                                TextColor="{StaticResource Success}" />

                        </Border>

                    </Grid>

                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="{StaticResource Divider}" />

                    <VerticalStackLayout Spacing="3">

                        <Label
                            Text="CONSULTATION DATE"
                            FontFamily="OpenSansSemibold"
                            FontSize="10"
                            TextColor="{StaticResource TextSecondary}" />

                        <Label
                            Text="{Binding Consultation.ConsultationDate, StringFormat='{0:dd MMMM yyyy, HH:mm}'}"
                            FontSize="14"
                            TextColor="{StaticResource TextPrimary}" />

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </Border>

            <!-- Diagnosis -->
            <Border
                Margin="0,12,0,0"
                Style="{StaticResource CardStyle}">

                <VerticalStackLayout Spacing="9">

                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="10">

                        <Border
                            Grid.Column="0"
                            WidthRequest="34"
                            HeightRequest="34"
                            BackgroundColor="{StaticResource PrimaryLight}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 9">

                            <Label
                                Text="DX"
                                FontFamily="OpenSansSemibold"
                                FontSize="10"
                                TextColor="{StaticResource Primary}"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />

                        </Border>

                        <Label
                            Grid.Column="1"
                            Text="Diagnosis"
                            Style="{StaticResource CardTitleStyle}"
                            FontSize="16"
                            VerticalTextAlignment="Center" />

                    </Grid>

                    <Label
                        Text="{Binding Consultation.Diagnosis}"
                        Style="{StaticResource BodyTextStyle}"
                        FontSize="14"
                        LineBreakMode="WordWrap" />

                </VerticalStackLayout>

            </Border>

            <!-- Treatment -->
            <Border
                Margin="0,12,0,0"
                Style="{StaticResource CardStyle}">

                <VerticalStackLayout Spacing="9">

                    <Label
                        Text="Treatment"
                        Style="{StaticResource CardTitleStyle}"
                        FontSize="16" />

                    <Label
                        Text="{Binding Consultation.Treatment}"
                        Style="{StaticResource BodyTextStyle}"
                        FontSize="14"
                        LineBreakMode="WordWrap" />

                </VerticalStackLayout>

            </Border>

            <!-- Consultation summary -->
            <Border
                Margin="0,12,0,0"
                Style="{StaticResource CardStyle}">

                <VerticalStackLayout Spacing="9">

                    <Label
                        Text="Consultation Summary"
                        Style="{StaticResource CardTitleStyle}"
                        FontSize="16" />

                    <Label
                        Text="{Binding Consultation.Summary}"
                        Style="{StaticResource BodyTextStyle}"
                        FontSize="14"
                        LineBreakMode="WordWrap" />

                </VerticalStackLayout>

            </Border>

            <!-- Follow-up information -->
            <Border
                Margin="0,12,0,0"
                Style="{StaticResource WarningBannerStyle}">

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="Follow-Up"
                        Style="{StaticResource CardTitleStyle}"
                        FontSize="16" />

                    <VerticalStackLayout Spacing="4">

                        <Label
                            Text="INSTRUCTIONS"
                            FontFamily="OpenSansSemibold"
                            FontSize="10"
                            TextColor="{StaticResource Warning}" />

                        <Label
                            Text="{Binding Consultation.FollowUpInstructions}"
                            FontSize="14"
                            TextColor="{StaticResource TextPrimary}"
                            LineBreakMode="WordWrap" />

                    </VerticalStackLayout>

                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="{StaticResource Border}" />

                    <VerticalStackLayout Spacing="4">

                        <Label
                            Text="FOLLOW-UP DATE"
                            FontFamily="OpenSansSemibold"
                            FontSize="10"
                            TextColor="{StaticResource Warning}" />

                        <Label
                            Text="{Binding Consultation.FollowUpDate, StringFormat='{0:dd MMMM yyyy}'}"
                            FontFamily="OpenSansSemibold"
                            FontSize="14"
                            TextColor="{StaticResource TextPrimary}" />

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </Border>

            <!-- Prescriptions -->
            <Label
                Text="Prescriptions"
                Margin="0,30,0,0"
                Style="{StaticResource SectionTitleStyle}"
                SemanticProperties.HeadingLevel="Level2" />

            <Label
                Text="Medication issued during this consultation."
                Margin="0,5,0,10"
                Style="{StaticResource MutedTextStyle}"
                FontSize="13" />

            <!-- No prescriptions state -->
            <Border
                Padding="24"
                Style="{StaticResource CardStyle}"
                IsVisible="{Binding HasNoPrescriptions}">

                <VerticalStackLayout
                    Spacing="9"
                    HorizontalOptions="Center">

                    <Border
                        WidthRequest="48"
                        HeightRequest="48"
                        BackgroundColor="{StaticResource PrimaryLight}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 14">

                        <Label
                            Text="Rx"
                            FontFamily="OpenSansSemibold"
                            FontSize="14"
                            TextColor="{StaticResource Primary}"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />

                    </Border>

                    <Label
                        Text="No prescriptions"
                        Style="{StaticResource CardTitleStyle}"
                        FontSize="15"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="No medication was recorded for this consultation."
                        Style="{StaticResource MutedTextStyle}"
                        FontSize="12"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap" />

                </VerticalStackLayout>

            </Border>

            <!-- Prescriptions issued during the consultation -->
            <VerticalStackLayout
                BindableLayout.ItemsSource="{Binding Prescriptions}"
                IsVisible="{Binding HasPrescriptions}"
                Spacing="12">

                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:Prescription">

                        <Border Style="{StaticResource CardStyle}">

                            <VerticalStackLayout Spacing="14">

                                <Grid
                                    ColumnDefinitions="Auto,*,Auto"
                                    ColumnSpacing="11">

                                    <Border
                                        Grid.Column="0"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        VerticalOptions="Start"
                                        BackgroundColor="{StaticResource PrimaryLight}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10">

                                        <Label
                                            Text="Rx"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="12"
                                            TextColor="{StaticResource Primary}"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center" />

                                    </Border>

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="3"
                                        VerticalOptions="Center">

                                        <Label
                                            Text="{Binding MedicationName}"
                                            Style="{StaticResource CardTitleStyle}"
                                            FontSize="16" />

                                        <Label
                                            Text="{Binding Dosage}"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="13"
                                            TextColor="{StaticResource Primary}" />

                                    </VerticalStackLayout>

                                    <Border
                                        Grid.Column="2"
                                        Padding="8,5"
                                        VerticalOptions="Start"
                                        BackgroundColor="{StaticResource PrimaryLight}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8">

                                        <Label
                                            Text="PRESCRIBED"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="9"
                                            TextColor="{StaticResource Primary}" />

                                    </Border>

                                </Grid>

                                <BoxView
                                    HeightRequest="1"
                                    BackgroundColor="{StaticResource Divider}" />

                                <Grid
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="12">

                                    <VerticalStackLayout
                                        Grid.Column="0"
                                        Spacing="3">

                                        <Label
                                            Text="FREQUENCY"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="10"
                                            TextColor="{StaticResource TextSecondary}" />

                                        <Label
                                            Text="{Binding Frequency}"
                                            FontSize="13"
                                            TextColor="{StaticResource TextPrimary}" />

                                    </VerticalStackLayout>

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="3">

                                        <Label
                                            Text="DURATION"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="10"
                                            TextColor="{StaticResource TextSecondary}" />

                                        <Label
                                            Text="{Binding Duration}"
                                            FontSize="13"
                                            TextColor="{StaticResource TextPrimary}" />

                                    </VerticalStackLayout>

                                </Grid>

                                <VerticalStackLayout Spacing="4">

                                    <Label
                                        Text="INSTRUCTIONS"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="10"
                                        TextColor="{StaticResource TextSecondary}" />

                                    <Label
                                        Text="{Binding Instructions}"
                                        Style="{StaticResource BodyTextStyle}"
                                        FontSize="13"
                                        LineBreakMode="WordWrap" />

                                </VerticalStackLayout>

                                <Grid
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="12">

                                    <VerticalStackLayout
                                        Grid.Column="0"
                                        Spacing="3">

                                        <Label
                                            Text="ISSUED"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="10"
                                            TextColor="{StaticResource TextSecondary}" />

                                        <Label
                                            Text="{Binding IssuedDate, StringFormat='{0:dd MMM yyyy}'}"
                                            FontSize="12"
                                            TextColor="{StaticResource TextPrimary}" />

                                    </VerticalStackLayout>

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="3">

                                        <Label
                                            Text="EXPIRY"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="10"
                                            TextColor="{StaticResource TextSecondary}" />

                                        <Label
                                            Text="{Binding ExpiryDate, StringFormat='{0:dd MMM yyyy}'}"
                                            FontSize="12"
                                            TextColor="{StaticResource TextPrimary}" />

                                    </VerticalStackLayout>

                                </Grid>

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>
                </BindableLayout.ItemTemplate>

            </VerticalStackLayout>

            <!-- Clinical information notice -->
            <Border
                Margin="0,18,0,0"
                Padding="12"
                BackgroundColor="{StaticResource SurfaceMuted}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 10">

                <Label
                    Text="This information forms part of your SmartClinic consultation record."
                    Style="{StaticResource MutedTextStyle}"
                    FontSize="11"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="WordWrap" />

            </Border>

            <!-- Clinic brand accent -->
            <BoxView
                Margin="0,26,0,0"
                WidthRequest="42"
                HeightRequest="3"
                CornerRadius="2"
                BackgroundColor="{StaticResource Secondary}"
                HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>