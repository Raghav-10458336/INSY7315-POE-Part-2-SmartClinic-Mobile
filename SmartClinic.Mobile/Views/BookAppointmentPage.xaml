<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SmartClinic.Mobile.Views.BookAppointmentPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:SmartClinic.Mobile.Models"
    Title="Book Appointment"
    BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>
        <VerticalStackLayout
            Padding="24,24,24,40"
            Spacing="0"
            MaximumWidthRequest="620"
            HorizontalOptions="Center">

            <!-- Page heading -->
            <Label
                Text="Book an Appointment"
                Style="{StaticResource PageTitleStyle}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Choose a doctor and an available appointment time."
                Margin="0,5,0,0"
                Style="{StaticResource PageSubtitleStyle}" />

            <!-- Loading feedback -->
            <HorizontalStackLayout
                Margin="0,20,0,0"
                Spacing="10"
                IsVisible="{Binding IsBusy}">

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    WidthRequest="22"
                    HeightRequest="22" />

                <Label
                    Text="Loading appointment information..."
                    Style="{StaticResource MutedTextStyle}"
                    VerticalTextAlignment="Center"
                    SemanticProperties.Description="Loading appointment information" />

            </HorizontalStackLayout>

            <!-- Error feedback -->
            <Border
                Margin="0,18,0,0"
                Style="{StaticResource ErrorBannerStyle}"
                IsVisible="{Binding HasError}">

                <Grid
                    ColumnDefinitions="4,*"
                    ColumnSpacing="10">

                    <BoxView
                        Grid.Column="0"
                        WidthRequest="4"
                        CornerRadius="2"
                        BackgroundColor="{StaticResource Secondary}"
                        VerticalOptions="Fill" />

                    <Label
                        Grid.Column="1"
                        Text="{Binding ErrorMessage}"
                        FontSize="13"
                        TextColor="{StaticResource Error}"
                        LineBreakMode="WordWrap"
                        VerticalTextAlignment="Center"
                        SemanticProperties.Description="Booking error message" />

                </Grid>

            </Border>

            <!-- Doctor selection -->
            <Label
                Text="Choose a doctor"
                Margin="0,28,0,8"
                Style="{StaticResource FieldLabelStyle}" />

            <Border Style="{StaticResource InputBorderStyle}">

                <Picker
                    Title="Select a doctor"
                    ItemsSource="{Binding Doctors}"
                    SelectedItem="{Binding SelectedDoctor}"
                    ItemDisplayBinding="{Binding FullName}"
                    SemanticProperties.Description="Select doctor" />

            </Border>

            <!-- Selected doctor details -->
            <Border
                Margin="0,14,0,0"
                Padding="16"
                BackgroundColor="{StaticResource PrimaryLight}"
                Stroke="{StaticResource Primary}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                IsVisible="{Binding HasSelectedDoctor}">

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="13">

                    <Border
                        Grid.Column="0"
                        WidthRequest="44"
                        HeightRequest="44"
                        VerticalOptions="Start"
                        BackgroundColor="{StaticResource Surface}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12">

                        <Label
                            Text="DR"
                            FontFamily="OpenSansSemibold"
                            FontSize="12"
                            TextColor="{StaticResource Primary}"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />

                    </Border>

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="3"
                        VerticalOptions="Center">

                        <Label
                            Text="{Binding SelectedDoctor.FullName}"
                            Style="{StaticResource CardTitleStyle}"
                            FontSize="16" />

                        <Label
                            Text="{Binding SelectedDoctor.Specialisation}"
                            FontSize="13"
                            TextColor="{StaticResource Primary}" />

                        <Label
                            Text="{Binding SelectedDoctor.Qualification}"
                            Style="{StaticResource MutedTextStyle}"
                            FontSize="12" />

                    </VerticalStackLayout>

                </Grid>

            </Border>

            <!-- Availability heading and action -->
            <Grid
                Margin="0,28,0,10"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="12">

                <Label
                    Grid.Column="0"
                    Text="Available times"
                    Style="{StaticResource FieldLabelStyle}"
                    VerticalTextAlignment="Center" />

                <Button
                    Grid.Column="1"
                    Text="View Times"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="14,7"
                    MinimumHeightRequest="40"
                    FontSize="12"
                    SemanticProperties.Description="View available appointment times"
                    Clicked="OnViewTimesClicked" />

            </Grid>

            <!-- Available appointment slots -->
            <CollectionView
                ItemsSource="{Binding AvailableSlots}"
                IsVisible="{Binding HasAvailableSlots}"
                SelectionMode="Single"
                SelectedItem="{Binding SelectedSlot}"
                HeightRequest="190">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout
                        Orientation="Vertical"
                        ItemSpacing="8" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:DoctorAvailability">

                        <Border
                            Padding="14"
                            BackgroundColor="{StaticResource Surface}"
                            Stroke="{StaticResource Border}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10">

                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="12">

                                <VerticalStackLayout
                                    Grid.Column="0"
                                    Spacing="3">

                                    <Label
                                        Text="{Binding StartDateTime, StringFormat='{0:dddd, dd MMM yyyy}'}"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="13"
                                        TextColor="{StaticResource TextPrimary}" />

                                    <Label
                                        Text="{Binding StartDateTime, StringFormat='{0:HH:mm}'}"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="13"
                                        TextColor="{StaticResource Primary}" />

                                </VerticalStackLayout>

                                <Border
                                    Grid.Column="1"
                                    Padding="9,5"
                                    VerticalOptions="Center"
                                    BackgroundColor="{StaticResource SuccessLight}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8">

                                    <Label
                                        Text="Available"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="10"
                                        TextColor="{StaticResource Success}" />

                                </Border>

                            </Grid>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <!-- Booking guidance -->
            <Border
                Margin="0,12,0,0"
                Padding="12"
                BackgroundColor="{StaticResource InfoLight}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 10"
                IsVisible="{Binding HasSelectedDoctor}">

                <Label
                    Text="Select one of the available times above to continue with your booking."
                    FontSize="12"
                    TextColor="{StaticResource Info}"
                    LineBreakMode="WordWrap" />

            </Border>

            <!-- Reason for visit -->
            <Label
                Text="Reason for visit"
                Margin="0,28,0,8"
                Style="{StaticResource FieldLabelStyle}" />

            <Border Style="{StaticResource InputBorderStyle}">

                <Editor
                    Text="{Binding ReasonForVisit}"
                    Placeholder="Briefly describe the reason for your appointment"
                    AutoSize="TextChanges"
                    MinimumHeightRequest="100"
                    SemanticProperties.Description="Reason for visit" />

            </Border>

            <Label
                Text="This helps the clinic prepare for your consultation."
                Margin="2,7,0,0"
                Style="{StaticResource MutedTextStyle}"
                FontSize="11" />

            <!-- Successful booking feedback -->
            <Border
                Margin="0,20,0,0"
                Style="{StaticResource SuccessBannerStyle}"
                IsVisible="{Binding HasSuccess}">

                <Grid
                    ColumnDefinitions="4,*"
                    ColumnSpacing="10">

                    <BoxView
                        Grid.Column="0"
                        WidthRequest="4"
                        CornerRadius="2"
                        BackgroundColor="{StaticResource Success}"
                        VerticalOptions="Fill" />

                    <Label
                        Grid.Column="1"
                        Text="{Binding SuccessMessage}"
                        FontSize="13"
                        TextColor="{StaticResource Success}"
                        LineBreakMode="WordWrap"
                        VerticalTextAlignment="Center"
                        SemanticProperties.Description="Appointment booking successful" />

                </Grid>

            </Border>

            <!-- Booking action -->
            <Button
                Text="Confirm Appointment"
                Margin="0,26,0,0"
                Style="{StaticResource PrimaryButtonStyle}"
                IsEnabled="{Binding IsNotBusy}"
                Command="{Binding CreateAppointmentCommand}"
                SemanticProperties.Description="Confirm appointment" />

            <!-- Security and confirmation reassurance -->
            <Border
                Margin="0,14,0,0"
                Padding="12"
                BackgroundColor="{StaticResource SurfaceMuted}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 10">

                <Label
                    Text="Your appointment details are submitted securely to Doringkloof Medical Centre."
                    Style="{StaticResource MutedTextStyle}"
                    FontSize="11"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="WordWrap" />

            </Border>

            <!-- Clinic brand accent -->
            <BoxView
                Margin="0,26,0,0"
                WidthRequest="42"
                HeightRequest="3"
                CornerRadius="2"
                BackgroundColor="{StaticResource Secondary}"
                HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>