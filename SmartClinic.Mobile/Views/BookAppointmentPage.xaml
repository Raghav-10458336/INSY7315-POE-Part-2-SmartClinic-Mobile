<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SmartClinic.Mobile.Views.BookAppointmentPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:SmartClinic.Mobile.Models"
    Title="Book Appointment"
    BackgroundColor="#F5F8FA">

    <ScrollView>
        <VerticalStackLayout
            Padding="24,24,24,40"
            Spacing="0">

            <!-- Page heading -->
            <Label
                Text="Book an Appointment"
                FontSize="26"
                FontAttributes="Bold"
                TextColor="#172B4D" />

            <Label
                Text="Choose a doctor and an available appointment time."
                Margin="0,5,0,0"
                FontSize="14"
                TextColor="#6B778C" />

            <!-- Loading feedback -->
            <HorizontalStackLayout
                Margin="0,20,0,0"
                Spacing="10"
                IsVisible="{Binding IsBusy}">

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    Color="#1565C0"
                    WidthRequest="22"
                    HeightRequest="22" />

                <Label
                    Text="Loading appointment information..."
                    FontSize="13"
                    TextColor="#6B778C"
                    VerticalTextAlignment="Center" />

            </HorizontalStackLayout>

            <!-- Error feedback -->
            <Border
                Margin="0,18,0,0"
                Padding="12"
                BackgroundColor="#FFEBEE"
                Stroke="#FFCDD2"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8"
                IsVisible="{Binding HasError}">

                <Label
                    Text="{Binding ErrorMessage}"
                    FontSize="13"
                    TextColor="#B71C1C"
                    LineBreakMode="WordWrap"
                    AutomationProperties.Name="Booking error message" />

            </Border>

            <!-- Doctor selection -->
            <Label
                Text="Choose a doctor"
                Margin="0,28,0,8"
                FontSize="15"
                FontAttributes="Bold"
                TextColor="#344563" />

            <Border
                Padding="12,3"
                BackgroundColor="White"
                Stroke="#D9E2EC"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10">

                <Picker
                    Title="Select a doctor"
                    ItemsSource="{Binding Doctors}"
                    SelectedItem="{Binding SelectedDoctor}"
                    ItemDisplayBinding="{Binding FullName}"
                    FontSize="15"
                    TextColor="#172B4D"
                    MinimumHeightRequest="50"
                    AutomationProperties.Name="Select doctor" />

            </Border>

            <!-- Doctor details -->
            <Border
                Margin="0,14,0,0"
                Padding="16"
                BackgroundColor="#E3F2FD"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 12"
                IsVisible="{Binding SelectedDoctor}">

                <VerticalStackLayout Spacing="4">

                    <Label
                        Text="{Binding SelectedDoctor.FullName}"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#172B4D" />

                    <Label
                        Text="{Binding SelectedDoctor.Specialisation}"
                        FontSize="13"
                        TextColor="#1565C0" />

                    <Label
                        Text="{Binding SelectedDoctor.Qualification}"
                        FontSize="12"
                        TextColor="#6B778C" />

                </VerticalStackLayout>

            </Border>

            <!-- Availability -->
            <Grid
                Margin="0,28,0,8"
                ColumnDefinitions="*,Auto">

                <Label
                    Grid.Column="0"
                    Text="Available times"
                    FontSize="15"
                    FontAttributes="Bold"
                    TextColor="#344563"
                    VerticalTextAlignment="Center" />

                <Button
                    Grid.Column="1"
                    Text="View Times"
                    Padding="14,7"
                    CornerRadius="8"
                    BackgroundColor="#E3F2FD"
                    TextColor="#1565C0"
                    FontSize="12"
                    FontAttributes="Bold"
                    AutomationProperties.Name="View available appointment times"
                    Clicked="OnViewTimesClicked" />

            </Grid>

            <!-- Available appointment slots -->
            <CollectionView
                ItemsSource="{Binding AvailableSlots}"
                IsVisible="{Binding HasAvailableSlots}"
                SelectionMode="Single"
                SelectedItem="{Binding SelectedSlot}"
                HeightRequest="190">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout
                        Orientation="Vertical"
                        ItemSpacing="8" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:DoctorAvailability">

                        <Border
                            Padding="14"
                            BackgroundColor="White"
                            Stroke="#D9E2EC"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10">

                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="12">

                                <VerticalStackLayout
                                    Grid.Column="0"
                                    Spacing="3">

                                    <Label
                                        Text="{Binding StartDateTime, StringFormat='{0:dddd, dd MMM yyyy}'}"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="#172B4D" />

                                    <Label
                                        Text="{Binding StartDateTime, StringFormat='{0:HH:mm}'}"
                                        FontSize="13"
                                        TextColor="#1565C0" />

                                </VerticalStackLayout>

                                <Label
                                    Grid.Column="1"
                                    Text="Available"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="#2E7D32"
                                    VerticalTextAlignment="Center" />

                            </Grid>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <!-- Reason for visit -->
            <Label
                Text="Reason for visit"
                Margin="0,28,0,8"
                FontSize="15"
                FontAttributes="Bold"
                TextColor="#344563" />

            <Border
                Padding="12"
                BackgroundColor="White"
                Stroke="#D9E2EC"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10">

                <Editor
                    Text="{Binding ReasonForVisit}"
                    Placeholder="Briefly describe the reason for your appointment"
                    AutoSize="TextChanges"
                    MinimumHeightRequest="100"
                    FontSize="14"
                    TextColor="#172B4D"
                    PlaceholderColor="#8993A4"
                    AutomationProperties.Name="Reason for visit" />

            </Border>

            <!-- Booking action -->
            <Button
                Text="Confirm Appointment"
                Margin="0,26,0,0"
                HeightRequest="52"
                CornerRadius="10"
                BackgroundColor="#1565C0"
                TextColor="White"
                FontSize="15"
                FontAttributes="Bold"
                IsEnabled="{Binding IsNotBusy}"
                AutomationProperties.Name="Confirm appointment" />

            <Label
                Text="You will be able to review the appointment before it is submitted."
                Margin="0,12,0,0"
                FontSize="12"
                TextColor="#8993A4"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>