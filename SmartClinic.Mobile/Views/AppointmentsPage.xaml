<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SmartClinic.Mobile.Views.AppointmentsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:SmartClinic.Mobile.Models"
    Title="Appointments"
    BackgroundColor="{StaticResource PageBackground}">

    <Grid
        Padding="24,24,24,30"
        RowDefinitions="Auto,Auto,Auto,*"
        MaximumWidthRequest="620"
        HorizontalOptions="Center">

        <!-- Page heading -->
        <VerticalStackLayout
            Grid.Row="0"
            Spacing="5">

            <Label
                Text="My Appointments"
                Style="{StaticResource PageTitleStyle}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="View and manage your clinic appointments."
                Style="{StaticResource PageSubtitleStyle}" />

        </VerticalStackLayout>

        <!-- Primary booking action -->
        <Button
            Grid.Row="1"
            Text="Book Appointment"
            Clicked="OnBookAppointmentClicked"
            Margin="0,22,0,0"
            Style="{StaticResource PrimaryButtonStyle}"
            SemanticProperties.Description="Book a new appointment" />

        <!-- Loading, error and success feedback -->
        <VerticalStackLayout
            Grid.Row="2"
            Margin="0,18,0,0"
            Spacing="12">

            <HorizontalStackLayout
                Spacing="10"
                IsVisible="{Binding IsBusy}">

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    WidthRequest="22"
                    HeightRequest="22" />

                <Label
                    Text="Updating appointments..."
                    Style="{StaticResource MutedTextStyle}"
                    VerticalTextAlignment="Center"
                    SemanticProperties.Description="Updating appointments" />

            </HorizontalStackLayout>

            <!-- Error feedback -->
            <Border
                Style="{StaticResource ErrorBannerStyle}"
                IsVisible="{Binding HasError}">

                <Grid
                    ColumnDefinitions="4,*"
                    ColumnSpacing="10">

                    <BoxView
                        Grid.Column="0"
                        WidthRequest="4"
                        CornerRadius="2"
                        BackgroundColor="{StaticResource Secondary}"
                        VerticalOptions="Fill" />

                    <Label
                        Grid.Column="1"
                        Text="{Binding ErrorMessage}"
                        FontSize="13"
                        TextColor="{StaticResource Error}"
                        LineBreakMode="WordWrap"
                        VerticalTextAlignment="Center"
                        SemanticProperties.Description="Appointments error message" />

                </Grid>

            </Border>

            <!-- Success feedback -->
            <Border
                Style="{StaticResource SuccessBannerStyle}"
                IsVisible="{Binding HasSuccess}">

                <Grid
                    ColumnDefinitions="4,*"
                    ColumnSpacing="10">

                    <BoxView
                        Grid.Column="0"
                        WidthRequest="4"
                        CornerRadius="2"
                        BackgroundColor="{StaticResource Success}"
                        VerticalOptions="Fill" />

                    <Label
                        Grid.Column="1"
                        Text="{Binding SuccessMessage}"
                        FontSize="13"
                        TextColor="{StaticResource Success}"
                        LineBreakMode="WordWrap"
                        VerticalTextAlignment="Center"
                        SemanticProperties.Description="Appointments success message" />

                </Grid>

            </Border>

        </VerticalStackLayout>

        <!-- Appointment content -->
        <Grid
            Grid.Row="3"
            Margin="0,20,0,0">

            <!-- Empty state -->
            <Border
                Padding="24"
                VerticalOptions="Start"
                Style="{StaticResource CardStyle}"
                IsVisible="{Binding HasNoAppointments}">

                <VerticalStackLayout
                    Spacing="10"
                    HorizontalOptions="Center">

                    <Border
                        WidthRequest="54"
                        HeightRequest="54"
                        BackgroundColor="{StaticResource PrimaryLight}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        HorizontalOptions="Center">

                        <Label
                            Text="APT"
                            FontFamily="OpenSansSemibold"
                            FontSize="12"
                            TextColor="{StaticResource Primary}"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />

                    </Border>

                    <Label
                        Text="No appointments yet"
                        Style="{StaticResource CardTitleStyle}"
                        FontSize="17"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Your booked appointments will appear here."
                        Style="{StaticResource MutedTextStyle}"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap" />

                </VerticalStackLayout>

            </Border>

            <!-- Appointment list -->
            <CollectionView
                ItemsSource="{Binding Appointments}"
                IsVisible="{Binding HasAppointments}"
                SelectionMode="None">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout
                        Orientation="Vertical"
                        ItemSpacing="12" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Appointment">

                        <Border Style="{StaticResource CardStyle}">

                            <VerticalStackLayout Spacing="13">

                                <!-- Doctor and appointment status -->
                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="12">

                                    <VerticalStackLayout
                                        Grid.Column="0"
                                        Spacing="3">

                                        <Label
                                            Text="{Binding DoctorName}"
                                            Style="{StaticResource CardTitleStyle}"
                                            FontSize="17" />

                                        <Label
                                            Text="{Binding DoctorSpecialisation}"
                                            FontSize="13"
                                            TextColor="{StaticResource Primary}" />

                                    </VerticalStackLayout>

                                    <!-- Status badge -->
                                    <Border
                                        Grid.Column="1"
                                        Padding="9,5"
                                        VerticalOptions="Start"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8">

                                        <Border.Triggers>

                                            <!-- Scheduled -->
                                            <DataTrigger
                                                TargetType="Border"
                                                Binding="{Binding Status}"
                                                Value="{x:Static models:AppointmentStatus.Scheduled}">
                                                <Setter
                                                    Property="BackgroundColor"
                                                    Value="{StaticResource PrimaryLight}" />
                                            </DataTrigger>

                                            <!-- Confirmed -->
                                            <DataTrigger
                                                TargetType="Border"
                                                Binding="{Binding Status}"
                                                Value="{x:Static models:AppointmentStatus.Confirmed}">
                                                <Setter
                                                    Property="BackgroundColor"
                                                    Value="{StaticResource PrimaryLight}" />
                                            </DataTrigger>

                                            <!-- Checked in -->
                                            <DataTrigger
                                                TargetType="Border"
                                                Binding="{Binding Status}"
                                                Value="{x:Static models:AppointmentStatus.CheckedIn}">
                                                <Setter
                                                    Property="BackgroundColor"
                                                    Value="{StaticResource WarningLight}" />
                                            </DataTrigger>

                                            <!-- Waiting in queue -->
                                            <DataTrigger
                                                TargetType="Border"
                                                Binding="{Binding Status}"
                                                Value="{x:Static models:AppointmentStatus.InQueue}">
                                                <Setter
                                                    Property="BackgroundColor"
                                                    Value="{StaticResource WarningLight}" />
                                            </DataTrigger>

                                            <!-- Consultation in progress -->
                                            <DataTrigger
                                                TargetType="Border"
                                                Binding="{Binding Status}"
                                                Value="{x:Static models:AppointmentStatus.InConsultation}">
                                                <Setter
                                                    Property="BackgroundColor"
                                                    Value="{StaticResource PrimaryLight}" />
                                            </DataTrigger>

                                            <!-- Completed -->
                                            <DataTrigger
                                                TargetType="Border"
                                                Binding="{Binding Status}"
                                                Value="{x:Static models:AppointmentStatus.Completed}">
                                                <Setter
                                                    Property="BackgroundColor"
                                                    Value="{StaticResource SuccessLight}" />
                                            </DataTrigger>

                                            <!-- Cancelled -->
                                            <DataTrigger
                                                TargetType="Border"
                                                Binding="{Binding Status}"
                                                Value="{x:Static models:AppointmentStatus.Cancelled}">
                                                <Setter
                                                    Property="BackgroundColor"
                                                    Value="{StaticResource ErrorLight}" />
                                            </DataTrigger>

                                            <!-- No show -->
                                            <DataTrigger
                                                TargetType="Border"
                                                Binding="{Binding Status}"
                                                Value="{x:Static models:AppointmentStatus.NoShow}">
                                                <Setter
                                                    Property="BackgroundColor"
                                                    Value="{StaticResource ErrorLight}" />
                                            </DataTrigger>

                                        </Border.Triggers>

                                        <Label
                                            Text="{Binding Status}"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="11">

                                            <Label.Triggers>

                                                <!-- Scheduled -->
                                                <DataTrigger
                                                    TargetType="Label"
                                                    Binding="{Binding Status}"
                                                    Value="{x:Static models:AppointmentStatus.Scheduled}">
                                                    <Setter
                                                        Property="TextColor"
                                                        Value="{StaticResource Primary}" />
                                                </DataTrigger>

                                                <!-- Confirmed -->
                                                <DataTrigger
                                                    TargetType="Label"
                                                    Binding="{Binding Status}"
                                                    Value="{x:Static models:AppointmentStatus.Confirmed}">
                                                    <Setter
                                                        Property="TextColor"
                                                        Value="{StaticResource Primary}" />
                                                </DataTrigger>

                                                <!-- Checked in -->
                                                <DataTrigger
                                                    TargetType="Label"
                                                    Binding="{Binding Status}"
                                                    Value="{x:Static models:AppointmentStatus.CheckedIn}">
                                                    <Setter
                                                        Property="TextColor"
                                                        Value="{StaticResource Warning}" />
                                                </DataTrigger>

                                                <!-- Waiting in queue -->
                                                <DataTrigger
                                                    TargetType="Label"
                                                    Binding="{Binding Status}"
                                                    Value="{x:Static models:AppointmentStatus.InQueue}">
                                                    <Setter
                                                        Property="TextColor"
                                                        Value="{StaticResource Warning}" />
                                                </DataTrigger>

                                                <!-- Consultation in progress -->
                                                <DataTrigger
                                                    TargetType="Label"
                                                    Binding="{Binding Status}"
                                                    Value="{x:Static models:AppointmentStatus.InConsultation}">
                                                    <Setter
                                                        Property="TextColor"
                                                        Value="{StaticResource Primary}" />
                                                </DataTrigger>

                                                <!-- Completed -->
                                                <DataTrigger
                                                    TargetType="Label"
                                                    Binding="{Binding Status}"
                                                    Value="{x:Static models:AppointmentStatus.Completed}">
                                                    <Setter
                                                        Property="TextColor"
                                                        Value="{StaticResource Success}" />
                                                </DataTrigger>

                                                <!-- Cancelled -->
                                                <DataTrigger
                                                    TargetType="Label"
                                                    Binding="{Binding Status}"
                                                    Value="{x:Static models:AppointmentStatus.Cancelled}">
                                                    <Setter
                                                        Property="TextColor"
                                                        Value="{StaticResource Error}" />
                                                </DataTrigger>

                                                <!-- No show -->
                                                <DataTrigger
                                                    TargetType="Label"
                                                    Binding="{Binding Status}"
                                                    Value="{x:Static models:AppointmentStatus.NoShow}">
                                                    <Setter
                                                        Property="TextColor"
                                                        Value="{StaticResource Error}" />
                                                </DataTrigger>

                                            </Label.Triggers>

                                        </Label>

                                    </Border>

                                </Grid>

                                <BoxView
                                    HeightRequest="1"
                                    BackgroundColor="{StaticResource Divider}" />

                                <!-- Appointment date and time -->
                                <Grid
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="12">

                                    <VerticalStackLayout
                                        Grid.Column="0"
                                        Spacing="3">

                                        <Label
                                            Text="DATE"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="11"
                                            TextColor="{StaticResource TextSecondary}" />

                                        <Label
                                            Text="{Binding AppointmentDateTime, StringFormat='{0:dd MMM yyyy}'}"
                                            FontSize="14"
                                            TextColor="{StaticResource TextPrimary}" />

                                    </VerticalStackLayout>

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="3">

                                        <Label
                                            Text="TIME"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="11"
                                            TextColor="{StaticResource TextSecondary}" />

                                        <Label
                                            Text="{Binding AppointmentDateTime, StringFormat='{0:HH:mm}'}"
                                            FontSize="14"
                                            TextColor="{StaticResource TextPrimary}" />

                                    </VerticalStackLayout>

                                </Grid>

                                <!-- Reason for visit -->
                                <VerticalStackLayout Spacing="3">

                                    <Label
                                        Text="REASON FOR VISIT"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="11"
                                        TextColor="{StaticResource TextSecondary}" />

                                    <Label
                                        Text="{Binding ReasonForVisit}"
                                        Style="{StaticResource BodyTextStyle}"
                                        FontSize="13"
                                        LineBreakMode="WordWrap" />

                                </VerticalStackLayout>

                                <!-- Active appointment management actions -->
                                <Grid
                                    Margin="0,3,0,0"
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="10"
                                    IsVisible="{Binding CanManage}">

                                    <Button
                                        Grid.Column="0"
                                        Text="Reschedule"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        FontSize="13"
                                        Clicked="OnRescheduleAppointmentClicked"
                                        SemanticProperties.Description="Reschedule appointment" />

                                    <Button
                                        Grid.Column="1"
                                        Text="Cancel"
                                        Style="{StaticResource DangerButtonStyle}"
                                        FontSize="13"
                                        Clicked="OnCancelAppointmentClicked"
                                        SemanticProperties.Description="Cancel appointment" />

                                </Grid>

                                <!-- Check-in or existing queue access -->
                                <Button
                                    Text="{Binding QueueActionText}"
                                    IsVisible="{Binding CanAccessCheckIn}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    FontSize="13"
                                    Clicked="OnCheckInAppointmentClicked"
                                    SemanticProperties.Description="Check in or view queue status" />

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </Grid>

    </Grid>

</ContentPage>