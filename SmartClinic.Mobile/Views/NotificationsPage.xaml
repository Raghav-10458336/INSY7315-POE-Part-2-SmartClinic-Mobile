<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SmartClinic.Mobile.Views.NotificationsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:SmartClinic.Mobile.Models"
    Title="Notifications"
    BackgroundColor="{StaticResource PageBackground}">

    <Grid
        Padding="24,24,24,30"
        RowDefinitions="Auto,Auto,Auto,*"
        MaximumWidthRequest="620"
        HorizontalOptions="Center">

        <!-- Page heading and unread count -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="14">

            <VerticalStackLayout
                Grid.Column="0"
                Spacing="5">

                <Label
                    Text="Notifications"
                    Style="{StaticResource PageTitleStyle}"
                    SemanticProperties.HeadingLevel="Level1" />

                <Label
                    Text="Appointment reminders, confirmations and clinic updates."
                    Style="{StaticResource PageSubtitleStyle}"
                    LineBreakMode="WordWrap" />

            </VerticalStackLayout>

            <!-- Unread count -->
            <Border
                Grid.Column="1"
                Padding="11,7"
                VerticalOptions="Start"
                BackgroundColor="{StaticResource PrimaryLight}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 10"
                IsVisible="{Binding HasUnreadNotifications}">

                <HorizontalStackLayout Spacing="5">

                    <Label
                        Text="{Binding UnreadCount}"
                        FontFamily="OpenSansSemibold"
                        FontSize="13"
                        TextColor="{StaticResource Primary}" />

                    <Label
                        Text="unread"
                        FontSize="13"
                        TextColor="{StaticResource Primary}" />

                </HorizontalStackLayout>

            </Border>

        </Grid>

        <!-- Notification actions -->
        <Grid
            Grid.Row="1"
            Margin="0,22,0,0"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="12">

            <Label
                Grid.Column="0"
                Text="Recent notifications"
                Style="{StaticResource SectionTitleStyle}"
                VerticalTextAlignment="Center" />

            <Button
                Grid.Column="1"
                Text="Mark All Read"
                Style="{StaticResource SecondaryButtonStyle}"
                HeightRequest="44"
                Padding="14,0"
                FontSize="12"
                IsVisible="{Binding HasUnreadNotifications}"
                Command="{Binding MarkAllAsReadCommand}"
                SemanticProperties.Description="Mark all notifications as read" />

        </Grid>

        <!-- Loading and feedback -->
        <VerticalStackLayout
            Grid.Row="2"
            Margin="0,14,0,0"
            Spacing="10">

            <HorizontalStackLayout
                Spacing="10"
                IsVisible="{Binding IsBusy}">

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    WidthRequest="22"
                    HeightRequest="22" />

                <Label
                    Text="Loading notifications..."
                    Style="{StaticResource MutedTextStyle}"
                    VerticalTextAlignment="Center"
                    SemanticProperties.Description="Loading notifications" />

            </HorizontalStackLayout>

            <!-- Error feedback -->
            <Border
                Style="{StaticResource ErrorBannerStyle}"
                IsVisible="{Binding HasError}">

                <Grid
                    ColumnDefinitions="4,*"
                    ColumnSpacing="10">

                    <BoxView
                        Grid.Column="0"
                        WidthRequest="4"
                        CornerRadius="2"
                        BackgroundColor="{StaticResource Secondary}"
                        VerticalOptions="Fill" />

                    <Label
                        Grid.Column="1"
                        Text="{Binding ErrorMessage}"
                        FontSize="13"
                        TextColor="{StaticResource Error}"
                        LineBreakMode="WordWrap"
                        VerticalTextAlignment="Center"
                        SemanticProperties.Description="Notification error message" />

                </Grid>

            </Border>

            <!-- Success feedback -->
            <Border
                Style="{StaticResource SuccessBannerStyle}"
                IsVisible="{Binding HasSuccess}">

                <Grid
                    ColumnDefinitions="4,*"
                    ColumnSpacing="10">

                    <BoxView
                        Grid.Column="0"
                        WidthRequest="4"
                        CornerRadius="2"
                        BackgroundColor="{StaticResource Success}"
                        VerticalOptions="Fill" />

                    <Label
                        Grid.Column="1"
                        Text="{Binding SuccessMessage}"
                        FontSize="13"
                        TextColor="{StaticResource Success}"
                        LineBreakMode="WordWrap"
                        VerticalTextAlignment="Center"
                        SemanticProperties.Description="Notification success message" />

                </Grid>

            </Border>

        </VerticalStackLayout>

        <!-- Notification content -->
        <Grid
            Grid.Row="3"
            Margin="0,16,0,0">

            <!-- Empty state -->
            <Border
                Padding="28,30"
                VerticalOptions="Start"
                Style="{StaticResource CardStyle}"
                IsVisible="{Binding HasNoNotifications}">

                <VerticalStackLayout
                    Spacing="10"
                    HorizontalOptions="Center">

                    <Border
                        WidthRequest="54"
                        HeightRequest="54"
                        BackgroundColor="{StaticResource PrimaryLight}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16">

                        <Label
                            Text="N"
                            FontFamily="OpenSansSemibold"
                            FontSize="16"
                            TextColor="{StaticResource Primary}"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />

                    </Border>

                    <Label
                        Text="You're all caught up"
                        Margin="0,4,0,0"
                        Style="{StaticResource CardTitleStyle}"
                        FontSize="17"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Appointment reminders, confirmations and clinic updates will appear here."
                        Style="{StaticResource MutedTextStyle}"
                        FontSize="13"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap" />

                </VerticalStackLayout>

            </Border>

            <!-- Notification list -->
            <CollectionView
                ItemsSource="{Binding Notifications}"
                IsVisible="{Binding HasNotifications}"
                SelectionMode="None">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout
                        Orientation="Vertical"
                        ItemSpacing="12" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Notification">

                        <Border Style="{StaticResource CardStyle}">

                            <Grid
                                ColumnDefinitions="4,*"
                                ColumnSpacing="12">

                                <!-- Unread accent -->
                                <BoxView
                                    Grid.Column="0"
                                    WidthRequest="4"
                                    CornerRadius="2"
                                    BackgroundColor="{StaticResource Primary}"
                                    VerticalOptions="Fill"
                                    IsVisible="{Binding IsRead, Converter={StaticResource InvertedBoolConverter}}" />

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="10">

                                    <!-- Notification type and date -->
                                    <Grid
                                        ColumnDefinitions="*,Auto"
                                        ColumnSpacing="12">

                                        <HorizontalStackLayout
                                            Grid.Column="0"
                                            Spacing="8">

                                            <Border
                                                Padding="8,4"
                                                BackgroundColor="{StaticResource PrimaryLight}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 7">

                                                <Label
                                                    Text="{Binding Type}"
                                                    FontFamily="OpenSansSemibold"
                                                    FontSize="10"
                                                    TextColor="{StaticResource Primary}" />

                                            </Border>

                                            <!-- Unread indicator -->
                                            <Border
                                                WidthRequest="8"
                                                HeightRequest="8"
                                                VerticalOptions="Center"
                                                BackgroundColor="{StaticResource Primary}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 4"
                                                IsVisible="{Binding IsRead, Converter={StaticResource InvertedBoolConverter}}"
                                                SemanticProperties.Description="Unread notification" />

                                        </HorizontalStackLayout>

                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding CreatedAt, StringFormat='{0:dd MMM yyyy HH:mm}'}"
                                            FontSize="10"
                                            TextColor="{StaticResource TextSecondary}"
                                            VerticalTextAlignment="Center" />

                                    </Grid>

                                    <!-- Notification content -->
                                    <Label
                                        Text="{Binding Title}"
                                        Style="{StaticResource CardTitleStyle}"
                                        FontSize="16"
                                        LineBreakMode="WordWrap" />

                                    <Label
                                        Text="{Binding Message}"
                                        Style="{StaticResource BodyTextStyle}"
                                        FontSize="13"
                                        LineHeight="1.2"
                                        LineBreakMode="WordWrap" />

                                    <BoxView
                                        HeightRequest="1"
                                        BackgroundColor="{StaticResource Divider}" />

                                    <!-- Individual read action -->
                                    <Grid
                                        ColumnDefinitions="Auto,*">

                                        <Button
                                            Grid.Column="0"
                                            Text="Mark as Read"
                                            Style="{StaticResource TextButtonStyle}"
                                            HeightRequest="44"
                                            Padding="0"
                                            FontSize="12"
                                            HorizontalOptions="Start"
                                            IsVisible="{Binding IsRead, Converter={StaticResource InvertedBoolConverter}}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.MarkAsReadCommand}"
                                            CommandParameter="{Binding .}"
                                            SemanticProperties.Description="Mark this notification as read" />

                                        <!-- Read status -->
                                        <Border
                                            Grid.Column="0"
                                            Padding="9,5"
                                            BackgroundColor="{StaticResource SuccessLight}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8"
                                            HorizontalOptions="Start"
                                            IsVisible="{Binding IsRead}">

                                            <Label
                                                Text="READ"
                                                FontFamily="OpenSansSemibold"
                                                FontSize="9"
                                                TextColor="{StaticResource Success}" />

                                        </Border>

                                    </Grid>

                                </VerticalStackLayout>

                            </Grid>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </Grid>

    </Grid>

</ContentPage>