<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SmartClinic.Mobile.Views.ConsultationHistoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:SmartClinic.Mobile.Models"
    Title="Consultation History"
    BackgroundColor="{StaticResource PageBackground}">

    <Grid
        Padding="24,24,24,30"
        RowDefinitions="Auto,Auto,*"
        MaximumWidthRequest="620"
        HorizontalOptions="Center">

        <!-- Page heading -->
        <VerticalStackLayout
            Grid.Row="0"
            Spacing="5">

            <Label
                Text="Consultation History"
                Style="{StaticResource PageTitleStyle}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Review your previous consultations and medical information."
                Style="{StaticResource PageSubtitleStyle}"
                LineBreakMode="WordWrap" />

        </VerticalStackLayout>

        <!-- Loading and error feedback -->
        <VerticalStackLayout
            Grid.Row="1"
            Margin="0,18,0,0"
            Spacing="12">

            <HorizontalStackLayout
                Spacing="10"
                IsVisible="{Binding IsBusy}">

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    WidthRequest="22"
                    HeightRequest="22" />

                <Label
                    Text="Loading consultation history..."
                    Style="{StaticResource MutedTextStyle}"
                    VerticalTextAlignment="Center"
                    SemanticProperties.Description="Loading consultation history" />

            </HorizontalStackLayout>

            <Border
                Style="{StaticResource ErrorBannerStyle}"
                IsVisible="{Binding HasError}">

                <Grid
                    ColumnDefinitions="4,*"
                    ColumnSpacing="10">

                    <BoxView
                        Grid.Column="0"
                        WidthRequest="4"
                        CornerRadius="2"
                        BackgroundColor="{StaticResource Secondary}"
                        VerticalOptions="Fill" />

                    <Label
                        Grid.Column="1"
                        Text="{Binding ErrorMessage}"
                        FontSize="13"
                        TextColor="{StaticResource Error}"
                        LineBreakMode="WordWrap"
                        VerticalTextAlignment="Center"
                        SemanticProperties.Description="Consultation history error message" />

                </Grid>

            </Border>

        </VerticalStackLayout>

        <!-- Consultation content -->
        <Grid
            Grid.Row="2"
            Margin="0,20,0,0">

            <!-- Empty state -->
            <Border
                Padding="28,30"
                VerticalOptions="Start"
                Style="{StaticResource CardStyle}"
                IsVisible="{Binding HasNoConsultations}">

                <VerticalStackLayout
                    Spacing="10"
                    HorizontalOptions="Center">

                    <Border
                        WidthRequest="54"
                        HeightRequest="54"
                        BackgroundColor="{StaticResource PrimaryLight}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16">

                        <Label
                            Text="HX"
                            FontFamily="OpenSansSemibold"
                            FontSize="14"
                            TextColor="{StaticResource Primary}"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />

                    </Border>

                    <Label
                        Text="No consultation history"
                        Margin="0,4,0,0"
                        Style="{StaticResource CardTitleStyle}"
                        FontSize="17"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Completed consultations will appear here for you to review."
                        Style="{StaticResource MutedTextStyle}"
                        FontSize="13"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap" />

                </VerticalStackLayout>

            </Border>

            <!-- Consultation list -->
            <CollectionView
                ItemsSource="{Binding Consultations}"
                IsVisible="{Binding HasConsultations}"
                SelectionMode="None">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout
                        Orientation="Vertical"
                        ItemSpacing="12" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Consultation">

                        <Border Style="{StaticResource CardStyle}">

                            <VerticalStackLayout Spacing="14">

                                <!-- Doctor and consultation date -->
                                <Grid
                                    ColumnDefinitions="Auto,*,Auto"
                                    ColumnSpacing="12">

                                    <Border
                                        Grid.Column="0"
                                        WidthRequest="42"
                                        HeightRequest="42"
                                        VerticalOptions="Start"
                                        BackgroundColor="{StaticResource PrimaryLight}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 11">

                                        <Label
                                            Text="DR"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="11"
                                            TextColor="{StaticResource Primary}"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center" />

                                    </Border>

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="3"
                                        VerticalOptions="Center">

                                        <Label
                                            Text="{Binding DoctorName}"
                                            Style="{StaticResource CardTitleStyle}"
                                            FontSize="16" />

                                        <Label
                                            Text="Consultation"
                                            FontSize="12"
                                            TextColor="{StaticResource Primary}" />

                                    </VerticalStackLayout>

                                    <Border
                                        Grid.Column="2"
                                        Padding="9,5"
                                        VerticalOptions="Start"
                                        BackgroundColor="{StaticResource SuccessLight}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8">

                                        <Label
                                            Text="{Binding ConsultationDate, StringFormat='{0:dd MMM yyyy}'}"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="10"
                                            TextColor="{StaticResource Success}" />

                                    </Border>

                                </Grid>

                                <BoxView
                                    HeightRequest="1"
                                    BackgroundColor="{StaticResource Divider}" />

                                <!-- Diagnosis preview -->
                                <VerticalStackLayout Spacing="4">

                                    <Label
                                        Text="DIAGNOSIS"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="10"
                                        TextColor="{StaticResource TextSecondary}" />

                                    <Label
                                        Text="{Binding Diagnosis}"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="14"
                                        TextColor="{StaticResource TextPrimary}"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="2" />

                                </VerticalStackLayout>

                                <!-- Consultation summary preview -->
                                <VerticalStackLayout Spacing="4">

                                    <Label
                                        Text="SUMMARY"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="10"
                                        TextColor="{StaticResource TextSecondary}" />

                                    <Label
                                        Text="{Binding Summary}"
                                        Style="{StaticResource BodyTextStyle}"
                                        FontSize="13"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="3" />

                                </VerticalStackLayout>

                                <!-- Open the complete clinical record -->
                                <Button
                                    Text="View Consultation Details"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Clicked="OnViewConsultationClicked"
                                    SemanticProperties.Description="View consultation details" />

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </Grid>

    </Grid>

</ContentPage>