<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SmartClinic.Mobile.Views.PatientProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="My Profile"
    BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>
        <VerticalStackLayout
            Padding="24,24,24,40"
            Spacing="0"
            MaximumWidthRequest="620"
            HorizontalOptions="Center">

            <!-- Profile heading -->
            <Label
                Text="My Profile"
                Style="{StaticResource PageTitleStyle}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="View and manage your personal and healthcare information."
                Margin="0,5,0,0"
                Style="{StaticResource PageSubtitleStyle}"
                LineBreakMode="WordWrap" />

            <!-- Loading feedback -->
            <HorizontalStackLayout
                Margin="0,20,0,0"
                Spacing="10"
                IsVisible="{Binding IsBusy}">

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    WidthRequest="22"
                    HeightRequest="22" />

                <Label
                    Text="Loading your profile..."
                    Style="{StaticResource MutedTextStyle}"
                    VerticalTextAlignment="Center"
                    SemanticProperties.Description="Loading patient profile" />

            </HorizontalStackLayout>

            <!-- Error feedback -->
            <Border
                Margin="0,16,0,0"
                Style="{StaticResource ErrorBannerStyle}"
                IsVisible="{Binding HasError}">

                <Grid
                    ColumnDefinitions="4,*"
                    ColumnSpacing="10">

                    <BoxView
                        Grid.Column="0"
                        WidthRequest="4"
                        CornerRadius="2"
                        BackgroundColor="{StaticResource Secondary}"
                        VerticalOptions="Fill" />

                    <Label
                        Grid.Column="1"
                        Text="{Binding ErrorMessage}"
                        FontSize="13"
                        TextColor="{StaticResource Error}"
                        LineBreakMode="WordWrap"
                        VerticalTextAlignment="Center"
                        SemanticProperties.Description="Profile error message" />

                </Grid>

            </Border>

            <!-- Success feedback -->
            <Border
                Margin="0,16,0,0"
                Style="{StaticResource SuccessBannerStyle}"
                IsVisible="{Binding HasSuccess}">

                <Grid
                    ColumnDefinitions="4,*"
                    ColumnSpacing="10">

                    <BoxView
                        Grid.Column="0"
                        WidthRequest="4"
                        CornerRadius="2"
                        BackgroundColor="{StaticResource Success}"
                        VerticalOptions="Fill" />

                    <Label
                        Grid.Column="1"
                        Text="{Binding SuccessMessage}"
                        FontSize="13"
                        TextColor="{StaticResource Success}"
                        LineBreakMode="WordWrap"
                        VerticalTextAlignment="Center"
                        SemanticProperties.Description="Profile success message" />

                </Grid>

            </Border>

            <!-- Patient summary -->
            <Border
                Margin="0,22,0,0"
                Style="{StaticResource CardStyle}">

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="15">

                    <Border
                        WidthRequest="58"
                        HeightRequest="58"
                        BackgroundColor="{StaticResource PrimaryLight}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16">

                        <Label
                            Text="ME"
                            FontFamily="OpenSansSemibold"
                            FontSize="14"
                            TextColor="{StaticResource Primary}"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"
                            SemanticProperties.Description="Patient profile" />

                    </Border>

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="4"
                        VerticalOptions="Center">

                        <Label
                            Text="{Binding Patient.FullName}"
                            Style="{StaticResource CardTitleStyle}"
                            FontSize="18" />

                        <Label
                            Text="{Binding Patient.Email}"
                            Style="{StaticResource MutedTextStyle}"
                            FontSize="13"
                            LineBreakMode="TailTruncation" />

                    </VerticalStackLayout>

                </Grid>

            </Border>

            <!-- Personal information -->
            <Label
                Text="Personal information"
                Margin="0,28,0,12"
                Style="{StaticResource SectionTitleStyle}"
                SemanticProperties.HeadingLevel="Level2" />

            <Border Style="{StaticResource CardStyle}">

                <VerticalStackLayout Spacing="16">

                    <!-- First name -->
                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="First name"
                            Style="{StaticResource FieldLabelStyle}" />

                        <Border Style="{StaticResource InputBorderStyle}">
                            <Entry
                                Text="{Binding Patient.FirstName}"
                                IsReadOnly="{Binding IsEditing, Converter={StaticResource InvertedBoolConverter}}"
                                Placeholder="First name"
                                SemanticProperties.Description="Patient first name" />
                        </Border>

                    </VerticalStackLayout>

                    <!-- Last name -->
                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Last name"
                            Style="{StaticResource FieldLabelStyle}" />

                        <Border Style="{StaticResource InputBorderStyle}">
                            <Entry
                                Text="{Binding Patient.LastName}"
                                IsReadOnly="{Binding IsEditing, Converter={StaticResource InvertedBoolConverter}}"
                                Placeholder="Last name"
                                SemanticProperties.Description="Patient last name" />
                        </Border>

                    </VerticalStackLayout>

                    <!-- Date of birth -->
                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Date of birth"
                            Style="{StaticResource FieldLabelStyle}" />

                        <Border Style="{StaticResource InputBorderStyle}">
                            <DatePicker
                                Date="{Binding Patient.DateOfBirth}"
                                IsEnabled="{Binding IsEditing}"
                                Format="dd MMM yyyy"
                                SemanticProperties.Description="Patient date of birth" />
                        </Border>

                    </VerticalStackLayout>

                    <!-- Gender -->
                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Gender"
                            Style="{StaticResource FieldLabelStyle}" />

                        <Border Style="{StaticResource InputBorderStyle}">
                            <Entry
                                Text="{Binding Patient.Gender}"
                                IsReadOnly="{Binding IsEditing, Converter={StaticResource InvertedBoolConverter}}"
                                Placeholder="Gender"
                                SemanticProperties.Description="Patient gender" />
                        </Border>

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </Border>

            <!-- Contact information -->
            <Label
                Text="Contact information"
                Margin="0,28,0,12"
                Style="{StaticResource SectionTitleStyle}"
                SemanticProperties.HeadingLevel="Level2" />

            <Border Style="{StaticResource CardStyle}">

                <VerticalStackLayout Spacing="16">

                    <!-- Email -->
                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Email address"
                            Style="{StaticResource FieldLabelStyle}" />

                        <Border Style="{StaticResource InputBorderStyle}">
                            <Entry
                                Text="{Binding Patient.Email}"
                                IsReadOnly="{Binding IsEditing, Converter={StaticResource InvertedBoolConverter}}"
                                Keyboard="Email"
                                Placeholder="Email address"
                                SemanticProperties.Description="Patient email address" />
                        </Border>

                    </VerticalStackLayout>

                    <!-- Phone -->
                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Phone number"
                            Style="{StaticResource FieldLabelStyle}" />

                        <Border Style="{StaticResource InputBorderStyle}">
                            <Entry
                                Text="{Binding Patient.PhoneNumber}"
                                IsReadOnly="{Binding IsEditing, Converter={StaticResource InvertedBoolConverter}}"
                                Keyboard="Telephone"
                                Placeholder="Phone number"
                                SemanticProperties.Description="Patient phone number" />
                        </Border>

                    </VerticalStackLayout>

                    <!-- Address -->
                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Address"
                            Style="{StaticResource FieldLabelStyle}" />

                        <Border Style="{StaticResource InputBorderStyle}">
                            <Editor
                                Text="{Binding Patient.Address}"
                                IsReadOnly="{Binding IsEditing, Converter={StaticResource InvertedBoolConverter}}"
                                AutoSize="TextChanges"
                                MinimumHeightRequest="80"
                                Placeholder="Residential address"
                                SemanticProperties.Description="Patient residential address" />
                        </Border>

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </Border>

            <!-- Emergency contact -->
            <Label
                Text="Emergency contact"
                Margin="0,28,0,12"
                Style="{StaticResource SectionTitleStyle}"
                SemanticProperties.HeadingLevel="Level2" />

            <Border Style="{StaticResource CardStyle}">

                <VerticalStackLayout Spacing="16">

                    <!-- Emergency contact name -->
                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Contact name"
                            Style="{StaticResource FieldLabelStyle}" />

                        <Border Style="{StaticResource InputBorderStyle}">
                            <Entry
                                Text="{Binding Patient.EmergencyContactName}"
                                IsReadOnly="{Binding IsEditing, Converter={StaticResource InvertedBoolConverter}}"
                                Placeholder="Emergency contact name"
                                SemanticProperties.Description="Emergency contact name" />
                        </Border>

                    </VerticalStackLayout>

                    <!-- Emergency contact number -->
                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Contact number"
                            Style="{StaticResource FieldLabelStyle}" />

                        <Border Style="{StaticResource InputBorderStyle}">
                            <Entry
                                Text="{Binding Patient.EmergencyContactNumber}"
                                IsReadOnly="{Binding IsEditing, Converter={StaticResource InvertedBoolConverter}}"
                                Keyboard="Telephone"
                                Placeholder="Emergency contact number"
                                SemanticProperties.Description="Emergency contact number" />
                        </Border>

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </Border>

            <!-- Medical aid -->
            <Label
                Text="Medical aid"
                Margin="0,28,0,12"
                Style="{StaticResource SectionTitleStyle}"
                SemanticProperties.HeadingLevel="Level2" />

            <Border Style="{StaticResource CardStyle}">

                <VerticalStackLayout Spacing="16">

                    <!-- Medical aid provider -->
                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Provider"
                            Style="{StaticResource FieldLabelStyle}" />

                        <Border Style="{StaticResource InputBorderStyle}">
                            <Entry
                                Text="{Binding Patient.MedicalAidProvider}"
                                IsReadOnly="{Binding IsEditing, Converter={StaticResource InvertedBoolConverter}}"
                                Placeholder="Medical aid provider"
                                SemanticProperties.Description="Medical aid provider" />
                        </Border>

                    </VerticalStackLayout>

                    <!-- Medical aid membership number -->
                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Membership number"
                            Style="{StaticResource FieldLabelStyle}" />

                        <Border Style="{StaticResource InputBorderStyle}">
                            <Entry
                                Text="{Binding Patient.MedicalAidNumber}"
                                IsReadOnly="{Binding IsEditing, Converter={StaticResource InvertedBoolConverter}}"
                                Placeholder="Membership number"
                                SemanticProperties.Description="Medical aid membership number" />
                        </Border>

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </Border>

            <!-- View mode action -->
            <Button
                Text="Edit Profile"
                Margin="0,28,0,0"
                Style="{StaticResource PrimaryButtonStyle}"
                IsVisible="{Binding IsEditing, Converter={StaticResource InvertedBoolConverter}}"
                Command="{Binding EditProfileCommand}"
                SemanticProperties.Description="Edit patient profile" />

            <!-- Edit mode actions -->
            <Grid
                Margin="0,28,0,0"
                ColumnDefinitions="*,*"
                ColumnSpacing="12"
                IsVisible="{Binding IsEditing}">

                <Button
                    Grid.Column="0"
                    Text="Cancel"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding CancelEditCommand}"
                    SemanticProperties.Description="Cancel profile changes" />

                <Button
                    Grid.Column="1"
                    Text="Save Changes"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SaveProfileCommand}"
                    SemanticProperties.Description="Save profile changes" />

            </Grid>

            <!-- Account session -->
            <Button
                Text="Sign Out"
                Margin="0,18,0,0"
                Style="{StaticResource SecondaryButtonStyle}"
                Clicked="OnLogoutClicked"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                SemanticProperties.Description="Sign out of Smart Clinic" />

            <!-- Privacy reassurance -->
            <Border
                Margin="0,18,0,0"
                Padding="12"
                BackgroundColor="{StaticResource SurfaceMuted}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 10">

                <Label
                    Text="Your profile information is used to support your care and clinic services."
                    Style="{StaticResource MutedTextStyle}"
                    FontSize="11"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="WordWrap" />

            </Border>

            <!-- Clinic brand accent -->
            <BoxView
                Margin="0,26,0,0"
                WidthRequest="42"
                HeightRequest="3"
                CornerRadius="2"
                BackgroundColor="{StaticResource Secondary}"
                HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>