<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SmartClinic.Mobile.Views.PatientDashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Home"
    BackgroundColor="{StaticResource PageBackground}"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout
            Padding="24,26,24,40"
            Spacing="0"
            MaximumWidthRequest="620"
            HorizontalOptions="Center">

            <!-- Compact authenticated header -->
            <Grid
                ColumnDefinitions="*,Auto"
                ColumnSpacing="16">

                <VerticalStackLayout
                    Grid.Column="0"
                    Spacing="5"
                    VerticalOptions="Center">

                    <Image
                        Source="smartclinic_logo.png"
                        WidthRequest="128"
                        HeightRequest="58"
                        Aspect="AspectFit"
                        HorizontalOptions="Start"
                        SemanticProperties.Description="Doringkloof Medical Centre logo" />

                    <Label
                        Text="{Binding WelcomeMessage}"
                        Margin="0,8,0,0"
                        Style="{StaticResource PageTitleStyle}"
                        FontSize="26"
                        SemanticProperties.HeadingLevel="Level1" />

                    <Label
                        Text="Here's what's happening with your healthcare."
                        Style="{StaticResource PageSubtitleStyle}" />

                </VerticalStackLayout>

                <!-- Profile action -->
                <Border
                    Grid.Column="1"
                    WidthRequest="48"
                    HeightRequest="48"
                    VerticalOptions="Start"
                    BackgroundColor="{StaticResource PrimaryLight}"
                    Stroke="{StaticResource Primary}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    SemanticProperties.Description="Open patient profile">

                    <Label
                        Text="ME"
                        FontFamily="OpenSansSemibold"
                        FontSize="13"
                        TextColor="{StaticResource Primary}"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center" />

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="OnProfileTapped" />
                    </Border.GestureRecognizers>

                </Border>

            </Grid>

            <!-- Loading feedback -->
            <HorizontalStackLayout
                Margin="0,22,0,0"
                Spacing="10"
                IsVisible="{Binding IsBusy}">

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    WidthRequest="22"
                    HeightRequest="22" />

                <Label
                    Text="Loading your information..."
                    Style="{StaticResource MutedTextStyle}"
                    VerticalTextAlignment="Center"
                    SemanticProperties.Description="Loading dashboard information" />

            </HorizontalStackLayout>

            <!-- Error feedback -->
            <Border
                Margin="0,18,0,0"
                Style="{StaticResource ErrorBannerStyle}"
                IsVisible="{Binding HasError}">

                <Grid
                    ColumnDefinitions="4,*"
                    ColumnSpacing="10">

                    <BoxView
                        Grid.Column="0"
                        WidthRequest="4"
                        CornerRadius="2"
                        BackgroundColor="{StaticResource Secondary}"
                        VerticalOptions="Fill" />

                    <Label
                        Grid.Column="1"
                        Text="{Binding ErrorMessage}"
                        FontSize="13"
                        TextColor="{StaticResource Error}"
                        LineBreakMode="WordWrap"
                        VerticalTextAlignment="Center"
                        SemanticProperties.Description="Dashboard error message" />

                </Grid>
            </Border>

            <!-- Upcoming appointment -->
            <Label
                Text="Upcoming appointment"
                Margin="0,30,0,12"
                Style="{StaticResource SectionTitleStyle}"
                SemanticProperties.HeadingLevel="Level2" />

            <!-- Patient has an upcoming appointment -->
            <Border
                Style="{StaticResource CardStyle}"
                IsVisible="{Binding HasUpcomingAppointment}">

                <VerticalStackLayout Spacing="12">

                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="12">

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="3">

                            <Label
                                Text="{Binding UpcomingAppointment.DoctorName}"
                                Style="{StaticResource CardTitleStyle}" />

                            <Label
                                Text="{Binding UpcomingAppointment.DoctorSpecialisation}"
                                FontSize="13"
                                TextColor="{StaticResource Primary}" />

                        </VerticalStackLayout>

                        <Border
                            Grid.Column="1"
                            Padding="10,6"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            BackgroundColor="{StaticResource PrimaryLight}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 8">

                            <Label
                                Text="{Binding UpcomingAppointment.Status}"
                                FontFamily="OpenSansSemibold"
                                FontSize="11"
                                TextColor="{StaticResource Primary}" />

                        </Border>

                    </Grid>

                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="{StaticResource Divider}" />

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="12">

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="3">

                            <Label
                                Text="DATE"
                                FontFamily="OpenSansSemibold"
                                FontSize="11"
                                TextColor="{StaticResource TextSecondary}" />

                            <Label
                                Text="{Binding UpcomingAppointment.AppointmentDateTime, StringFormat='{0:dd MMM yyyy}'}"
                                FontSize="14"
                                TextColor="{StaticResource TextPrimary}" />

                        </VerticalStackLayout>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="3">

                            <Label
                                Text="TIME"
                                FontFamily="OpenSansSemibold"
                                FontSize="11"
                                TextColor="{StaticResource TextSecondary}" />

                            <Label
                                Text="{Binding UpcomingAppointment.AppointmentDateTime, StringFormat='{0:HH:mm}'}"
                                FontSize="14"
                                TextColor="{StaticResource TextPrimary}" />

                        </VerticalStackLayout>

                    </Grid>

                </VerticalStackLayout>

            </Border>

            <!-- No upcoming appointment -->
            <Border
                Style="{StaticResource CardStyle}"
                IsVisible="{Binding HasNoUpcomingAppointment}">

                <VerticalStackLayout Spacing="9">

                    <Label
                        Text="No upcoming appointment"
                        Style="{StaticResource CardTitleStyle}" />

                    <Label
                        Text="Book an appointment with one of our available doctors."
                        Style="{StaticResource MutedTextStyle}"
                        LineHeight="1.2" />

                    <Button
                        Text="Book Appointment"
                        Margin="0,8,0,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Clicked="OnBookAppointmentClicked"
                        SemanticProperties.Description="Book an appointment" />

                </VerticalStackLayout>

            </Border>

            <!-- Quick actions -->
            <Label
                Text="Quick actions"
                Margin="0,30,0,12"
                Style="{StaticResource SectionTitleStyle}"
                SemanticProperties.HeadingLevel="Level2" />

            <Grid
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="12"
                RowSpacing="12">

                <!-- Appointments -->
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    MinimumHeightRequest="136"
                    SemanticProperties.Description="View and manage appointments">

                    <VerticalStackLayout Spacing="8">

                        <Border
                            WidthRequest="42"
                            HeightRequest="42"
                            HorizontalOptions="Start"
                            BackgroundColor="{StaticResource PrimaryLight}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 11">

                            <Label
                                Text="APT"
                                FontFamily="OpenSansSemibold"
                                FontSize="11"
                                TextColor="{StaticResource Primary}"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />

                        </Border>

                        <Label
                            Text="Appointments"
                            Style="{StaticResource CardTitleStyle}"
                            FontSize="15" />

                        <Label
                            Text="View and manage"
                            Style="{StaticResource MutedTextStyle}"
                            FontSize="12" />

                    </VerticalStackLayout>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="OnAppointmentsTapped" />
                    </Border.GestureRecognizers>

                </Border>

                <!-- Check-in -->
                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource CardStyle}"
                    MinimumHeightRequest="136"
                    SemanticProperties.Description="Check in and join the clinic queue">

                    <VerticalStackLayout Spacing="8">

                        <Border
                            WidthRequest="42"
                            HeightRequest="42"
                            HorizontalOptions="Start"
                            BackgroundColor="{StaticResource SuccessLight}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 11">

                            <Label
                                Text="IN"
                                FontFamily="OpenSansSemibold"
                                FontSize="12"
                                TextColor="{StaticResource Success}"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />

                        </Border>

                        <Label
                            Text="Check In"
                            Style="{StaticResource CardTitleStyle}"
                            FontSize="15" />

                        <Label
                            Text="Join the clinic queue"
                            Style="{StaticResource MutedTextStyle}"
                            FontSize="12"
                            LineBreakMode="WordWrap" />

                    </VerticalStackLayout>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="OnCheckInTapped" />
                    </Border.GestureRecognizers>

                </Border>

                <!-- Prescriptions -->
                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    MinimumHeightRequest="136"
                    SemanticProperties.Description="View prescriptions">

                    <VerticalStackLayout Spacing="8">

                        <Border
                            WidthRequest="42"
                            HeightRequest="42"
                            HorizontalOptions="Start"
                            BackgroundColor="{StaticResource PrimaryLight}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 11">

                            <Label
                                Text="Rx"
                                FontFamily="OpenSansSemibold"
                                FontSize="15"
                                TextColor="{StaticResource Primary}"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />

                        </Border>

                        <Label
                            Text="Prescriptions"
                            Style="{StaticResource CardTitleStyle}"
                            FontSize="15" />

                        <Label
                            Text="View your medication"
                            Style="{StaticResource MutedTextStyle}"
                            FontSize="12"
                            LineBreakMode="WordWrap" />

                    </VerticalStackLayout>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="OnPrescriptionsTapped" />
                    </Border.GestureRecognizers>

                </Border>

                <!-- Consultation history -->
                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Style="{StaticResource CardStyle}"
                    MinimumHeightRequest="136"
                    SemanticProperties.Description="View consultation history">

                    <VerticalStackLayout Spacing="8">

                        <Border
                            WidthRequest="42"
                            HeightRequest="42"
                            HorizontalOptions="Start"
                            BackgroundColor="{StaticResource SecondaryLight}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 11">

                            <Label
                                Text="HX"
                                FontFamily="OpenSansSemibold"
                                FontSize="12"
                                TextColor="{StaticResource Secondary}"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />

                        </Border>

                        <Label
                            Text="History"
                            Style="{StaticResource CardTitleStyle}"
                            FontSize="15" />

                        <Label
                            Text="Past consultations"
                            Style="{StaticResource MutedTextStyle}"
                            FontSize="12"
                            LineBreakMode="WordWrap" />

                    </VerticalStackLayout>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="OnConsultationHistoryTapped" />
                    </Border.GestureRecognizers>

                </Border>

            </Grid>

            <!-- Notifications -->
            <Border
                Margin="0,12,0,0"
                Style="{StaticResource CardStyle}"
                MinimumHeightRequest="90"
                SemanticProperties.Description="Open notifications">

                <Grid
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="14">

                    <Border
                        Grid.Column="0"
                        WidthRequest="46"
                        HeightRequest="46"
                        VerticalOptions="Center"
                        BackgroundColor="{StaticResource PrimaryLight}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12">

                        <Label
                            Text="N"
                            FontFamily="OpenSansSemibold"
                            FontSize="15"
                            TextColor="{StaticResource Primary}"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />

                    </Border>

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="4"
                        VerticalOptions="Center">

                        <Label
                            Text="Notifications"
                            Style="{StaticResource CardTitleStyle}"
                            FontSize="15" />

                        <Label
                            Text="Reminders, confirmations and clinic updates"
                            Style="{StaticResource MutedTextStyle}"
                            FontSize="12"
                            LineBreakMode="WordWrap" />

                    </VerticalStackLayout>

                    <Label
                        Grid.Column="2"
                        Text="›"
                        FontSize="28"
                        TextColor="{StaticResource Primary}"
                        VerticalTextAlignment="Center"
                        SemanticProperties.Description="Open notifications" />

                </Grid>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Tapped="OnNotificationsTapped" />
                </Border.GestureRecognizers>

            </Border>

            <!-- Clinic status -->
            <Label
                Text="Clinic status"
                Margin="0,30,0,12"
                Style="{StaticResource SectionTitleStyle}"
                SemanticProperties.HeadingLevel="Level2" />

            <Border Style="{StaticResource CardStyle}">

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="14">

                    <Border
                        WidthRequest="44"
                        HeightRequest="44"
                        VerticalOptions="Center"
                        BackgroundColor="{StaticResource SuccessLight}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12">

                        <Label
                            Text="OK"
                            FontFamily="OpenSansSemibold"
                            FontSize="11"
                            TextColor="{StaticResource Success}"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />

                    </Border>

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="3"
                        VerticalOptions="Center">

                        <Label
                            Text="Not checked in"
                            Style="{StaticResource CardTitleStyle}"
                            FontSize="14" />

                        <Label
                            Text="Your queue information will appear here after check-in."
                            Style="{StaticResource MutedTextStyle}"
                            FontSize="12"
                            LineBreakMode="WordWrap" />

                    </VerticalStackLayout>

                </Grid>

            </Border>

            <!-- Subtle clinic brand accent -->
            <BoxView
                Margin="0,28,0,0"
                WidthRequest="42"
                HeightRequest="3"
                CornerRadius="2"
                BackgroundColor="{StaticResource Secondary}"
                HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>